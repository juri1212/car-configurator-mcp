9,"_1502":3025,"_2831":3026,"_2833":3027,"_566":3028,"_2836":-7,"_2837":55,"_1500":2183,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":3016,"_2828":3017,"_572":2829,"_1502":3018,"_2831":3019,"_2833":3020,"_566":3021,"_2836":-7,"_2837":55,"_1500":2184,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":3008,"_2828":3009,"_572":2829,"_1502":3010,"_2831":3011,"_2833":3012,"_566":3013,"_2836":3014,"_2837":55,"_1500":2185,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":3000,"_2828":3001,"_572":2829,"_1502":3002,"_2831":3003,"_2833":3004,"_566":3005,"_2836":3006,"_2837":55,"_1500":2186,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2992,"_2828":2993,"_572":2829,"_1502":2994,"_2831":2995,"_2833":2996,"_566":2997,"_2836":2998,"_2837":55,"_1500":2187,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2984,"_2828":2985,"_572":2829,"_1502":2986,"_2831":2987,"_2833":2988,"_566":2989,"_2836":2990,"_2837":55,"_1500":2188,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2977,"_2828":2978,"_572":2829,"_1502":2979,"_2831":2980,"_2833":2981,"_566":2982,"_2836":-7,"_2837":55,"_1500":2189,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2969,"_2828":2970,"_572":2829,"_1502":2971,"_2831":2972,"_2833":2973,"_566":2974,"_2836":2975,"_2837":55,"_1500":2190,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2961,"_2828":2962,"_572":2829,"_1502":2963,"_2831":2964,"_2833":2965,"_566":2966,"_2836":2967,"_2837":55,"_1500":2191,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2953,"_2828":2954,"_572":2829,"_1502":2955,"_2831":2956,"_2833":2957,"_566":2958,"_2836":2959,"_2837":55,"_1500":2192,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2945,"_2828":2946,"_572":2829,"_1502":2947,"_2831":2948,"_2833":2949,"_566":2950,"_2836":2951,"_2837":55,"_1500":2193,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2937,"_2828":2938,"_572":2829,"_1502":2939,"_2831":2940,"_2833":2941,"_566":2942,"_2836":2943,"_2837":55,"_1500":2194,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2928,"_2828":2929,"_572":2829,"_1502":2930,"_2831":2931,"_2833":2932,"_566":2933,"_2836":2934,"_2837":55,"_1500":2195,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2920,"_2828":2921,"_572":2829,"_1502":2922,"_2831":2923,"_2833":2924,"_566":2925,"_2836":2926,"_2837":55,"_1500":2196,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2912,"_2828":2913,"_572":2829,"_1502":2914,"_2831":2915,"_2833":2916,"_566":2917,"_2836":2918,"_2837":55,"_1500":2197,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2904,"_2828":2905,"_572":2829,"_1502":2906,"_2831":2907,"_2833":2908,"_566":2909,"_2836":2910,"_2837":55,"_1500":2198,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2895,"_2828":2896,"_572":2829,"_1502":2897,"_2831":2898,"_2833":2899,"_566":2900,"_2836":2901,"_2837":55,"_1500":2199,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2887,"_2828":2888,"_572":2829,"_1502":2889,"_2831":2890,"_2833":2891,"_566":2892,"_2836":2893,"_2837":55,"_1500":2200,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2879,"_2828":2880,"_572":2829,"_1502":2881,"_2831":2882,"_2833":2883,"_566":2884,"_2836":2885,"_2837":55,"_1500":2201,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2871,"_2828":2872,"_572":2829,"_1502":2873,"_2831":2874,"_2833":2875,"_566":2876,"_2836":2877,"_2837":55,"_1500":2202,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2862,"_2828":2863,"_572":2829,"_1502":2864,"_2831":2865,"_2833":2866,"_566":2867,"_2836":2868,"_2837":55,"_1500":2203,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2854,"_2828":2855,"_572":2829,"_1502":2856,"_2831":2857,"_2833":2858,"_566":2859,"_2836":2860,"_2837":55,"_1500":2204,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2845,"_2828":2846,"_572":2829,"_1502":2847,"_2831":2848,"_2833":2849,"_566":2850,"_2836":2851,"_2837":55,"_1500":2205,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},{"_2826":2827,"_2828":770,"_572":2829,"_1502":2830,"_2831":2832,"_2833":2834,"_566":2835,"_2836":-7,"_2837":55,"_1500":2206,"_277":2838,"_2839":-7,"_2840":71,"_2841":-7},"color",[2844],"code","W","carraraweißmetallic","studioImage","/assets/pts/studio_XB.jpg?h=a8aa9dce83e1db6cd55f0b2d6254c0b2","tags",[2842,2843],"Weiß wie Marmor: carraraweißmetallic ist ein moderner hellstrahlender Farbton, der bei Porsche einen festen Platz im Farbprogramm hat. Carraraweißmetallic wird oft falsch geschrieben und mit „carrera“ assoziiert, doch bei Carrara handelt es sich um eine Art von Marmor, der oftmals für Denkmäler und Bildhauerarbeiten verwendet wird. Der Carrara Marmor kommt in den Apuanischen Alpen vor und ist durch die Arbeiten des italienischen Malers sowie Bildhauers Michelangelo bekannt geworden.<br><br>Der leuchtende Weißfarbton carraraweißmetallic verkörpert eine hochwertige Ausstrahlung, die durch den metallischen Schimmereffekt die Karosserieformen noch besser zur Geltung bringen lässt.","video","isSelected","10.460,10 €","priceSecondary","exclusive","sonderwunsch","TAG1","TAG3","#d1d7d8",[2853],"E4","cremeweiß","/assets/pts/studio_E4.jpg?h=7fb0f7a8d7814f7bec91ebe6d5c96b84",[2852,2843],"Wohlfühlfaktor: der weiche und warme Farbton cremeweiß ist eine Porsche Farbentwicklung, die seit den frühen 2000er Jahren als Farboption für die Modellreihen 911 (997.2) und 718 (987.2) zur Auswahl steht. Am längsten ist die Lackierung für den 718 Cayman verfügbar gewesen.<br><br>Cremeweiß ist eine moderne Porsche Farbe, die ein ähnlicher Farbton wie die Farbe Chiffronwhite aus den 1980er Jahren darstellt. Cremeweiß strahlt Wärme und Behaglichkeit aus, ohne zu hell oder aufdringlich zu wirken. Der Lackton ist einladend und lässt sich mit einer Vielzahl an Farben kombinieren. Der gelblich ins Beige gehende Unterton verleiht cremeweiß ein luxuriöses Aussehen.","https://player.vimeo.com/video/1097505534?h=6d9e0dec77","TAG2","#decfb5",[2861],"F3","elfenbein","/assets/pts/studio_F3.jpg?h=4af639eddb72c7b904a846b03c640c86",[2852,2843],"Das Unikat: die helle Farbe elfenbein hat historischen Wert und geht auf das Jahr 1950 zurück. Als „Elfenbein R 704“ konnte die Farbe für den 356A bestellt werden, es erfolgte die Übernahme der Serienfarbe auf die nachfolgenden 356-Modelle.<br><br>Elfenbein ist ein vielseitiger Weißton, der ein Gefühl von Wärme und Gemütlichkeit verströmt. Die Farbe wird auch mit Luxus und Eleganz assoziiert.<br><br>Elfenbein ist eine blasse, cremeweiße Farbe, die an den Stoßzahn eines Elefanten erinnert. Es ist ein warmer und gedämpfter Weißton mit einem leicht gelblichen oder beigen Unterton.","https://player.vimeo.com/video/1099309206?h=e6f3e7cbdc","#eedba0",[2870],"EM","sepiabraun","/assets/pts/studio_EM.jpg?h=6dc4cdf2455c2d34e61d63ec44e3c1a3",[2852,2869],"<p>Nostalgie: sepiabraun ist ein gedeckter, erdiger Braunton, der wie die traditionelle Sepia-Fotografie nach dem bräunlichen bis grauschwarzen Farbpigment benannt ist. Der helle Farbstoff wird aus dem Tintenbeutel von Tintenfischen gewonnen und wird auch in der Aquarellmalerei eingesetzt.</p><p><br></p><p>Die historische Porsche Farbe ist ab Mitte der 1960er Jahre in fünf unterschiedlichen Farbcodes auf den Modellen 911 sowie 912 verfügbar. Darunter zählen R8007, 6836, 7474, 7410 und der heutige Farbcode 415, der auch schon Anfang der 1970er Jahre vorhanden war.</p><p><br></p><p>Sepiabraun ist eine gedeckte Farbe mit einem leicht gelblich-orangenen Farbton, der ein Vintage- und Antik-Aussehen verleiht. Der Farbton schafft eine warme und gemütliche Atmosphäre mit viel Charme.</p>","https://player.vimeo.com/video/1099287927?h=b1859a0b96","TAG6","#6e482e",[2878],"L3","maronenbraunmetallic","/assets/pts/studio_L3.jpg?h=6bba5bb2392f609be68d12267aa74924",[2842,2869],"Erlesener Luxus: maronenbraunmetallic ist ein warmer wie satter Braunton mit rötlichen Untertönen, der nach dem Kastanienbaum und seinen Nüssen benannt ist. Die Farbe ist seit der Los Angeles Auto Show 2014 bekannt, als Porsche die auf 100 Stück limitierte Panamera Exclusive Series vorgestellt hat.","https://player.vimeo.com/video/1099290982?h=4dfca621cd","#52463f",[2886],"B2","anthrazitbraunmetallic","/assets/pts/studio_B2.jpg?h=8cc51be4870dafa5c69ccff8a48d165e",[2842,2869],"Wiederbelebend: anthrazitbraunmetallic gewinnt in den 2000er Jahren an Attraktivität, als Braun- und Grautöne beliebt werden. Porsche hat den modernen Braunton für die 911 Modelle (991.1) sowie für Boxster/Cayman (982) als Serienfarbe angeboten. In den 2010er Jahren ist neben anthrazitbraunmetallic noch mahagonimetallic als Braunton verfügbar.<br><br>Die braune Färbung von anthrazitbraunmetallic erinnert an die in der Erde vorkommende Anthrazitkohle und wirkt etwas grauer als der ähnlich anmutende Farbton macadamiametallic. Das metallische Braun steht für Wärme, Zuverlässigkeit und eine natürliche Qualität.<br><br>Die attraktive Farbe verkörpert Stabilität und wird besonders gerne bei einem Boxster oder einem Cayman gewählt. Mit anthrazitbraunmetallic entsteht ein klassischer und zeitloser Look, der dennoch raffiniert wirkt.","https://player.vimeo.com/video/1099296485?h=46780f096c","#433e3d",[2894],"K7","macadamiametallic","/assets/pts/studio_K7.jpg?h=944135a475082e2ae12eda0989598eb2",[2842,2869],"<p>Zurückhaltende Lässigkeit: macadamiametallic ist ein angenehm anmutender Braunton, dessen Bezeichnung vermutlich auf die reichhaltige hawaiianische Baumnuss zurückgeht. Der erdige Farbton erinnert an natürliche Materialien wie Holz, Leder sowie Stein und entfaltet dadurch eine einladende Ausstrahlung. Die zurückhaltende Farbe ist durch ihre gewisse Einfachheit gekennzeichnet und bei Porsche Mitte der 2000er Jahre für die Modelle 911, 718 und Cayenne verfügbar gewesen.</p><p><br></p><p>Macadamiametallic ist ein warmer, mittel- bis dunkelbrauner Farbton. Die weiche und gedämpfte Farbe wird mit Komfort assoziiert und kreiert eine eigene gemütliche Atmosphäre.</p>","https://player.vimeo.com/video/1099296990?h=dff360a7e6","#392e2a",[2903],"E8","diamantschwarzmetallic","/assets/pts/studio_E8.jpg?h=92f136059d8a81ed08ff484b443f6c1e",[2842,2902],"Die nächste Dimension: diamantschwarzmetallic ist eine auffällige Farbe, die ein tiefes Schwarz mit einem charakteristischen Schimmer-Effekt repräsentiert. Die metallischen Partikel der tiefschwarzen Farbe reflektieren das Licht in verschiedene Richtungen. So entsteht eine besondere Farbtiefe und eine eindrückliche Dimensionalität, die den Anschein von Glitzer oder diamantähnlichem Funkeln erweckt. Der Effekt lässt sich durch den Einsatz metallischer oder perlmuttartiger Pigmente im Lack erzielen, die diamantschwarzmetallic ein dezentes Schillern und Leuchten verleihen.<br><br>Die Farbe wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses umgesetzt und ist heute als Farbe nach Wahl Option verfügbar.<br><br>Diamantschwarzmetallic wirkt bei bestimmten Lichtverhältnissen wie ein dunkles Grau, bei hellem Licht sogar wie ein subtiler dunkelblauer Ton. In jedem Fall verkörpert die satte Farbe einen luxuriösen und hochwertigen Anspruch, der hohe Glanzgrad sorgt unverwechselbar für Glamour.","https://player.vimeo.com/video/1098211941?h=1c1b5dcd59","TAG8","#17171d",[2911],"X9","kaffeeschwarz","/assets/pts/studio_X9.jpg?h=3cee6b4e0168600f31e06a5b6bffb702",[2852,2902],"Beliebter Klassiker: kaffeeschwarz ist ein Schwarzfarbton, der bereits Ende der 1970er Jahre unter der Bezeichnung moccaschwarz verfügbar war. Die satte braunschwarze Farbe verfügt über einen besonderen Glanz und erscheint nicht so dunkel, wie die Bezeichnung kaffeeschwarz vermuten lässt. Der Braunanteil an kaffeeschwarz ist stark ausgeprägt und kommt insbesondere bei Sonnenlicht eindrucksvoll zur Geltung. So wirkt die Farbe bei Tag braun und bei Nacht schwarz.<br><br>Schwarztöne mit warmen Untertönen wie kaffeeschwarz wirken beruhigend, erdend und vermitteln eine angenehme Wärme. Der Farbton steht aber auch für Sicherheit und verkörpert zugleich eine entspannende Wirkung.","https://player.vimeo.com/video/1097494397?h=80e6d988e8","#261f1b",[2919],"D3","carbonschwarzmetallic","/assets/pts/studio_D3.jpg?h=ead539583b231ed4e1fdc14fc70d3666",[2842,2902],"Athletische Eleganz: carbonschwarzmetallic ist ein dunkler, kräftiger Schwarzton, der durch den einzigartigen Glanzeffekt eine eindrückliche Farbtiefe verkörpert.<br><br>Die Farbe wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses umgesetzt und ist heute für Porsche Kunden als Farbe nach Wahl Option bestellbar.<br><br>Carbonschwarzmetallic ist ein glänzendes Schwarz, in dem das Licht aus allen Richtungen und Winkeln reflektiert wird. Bei direkter Beleuchtung wirkt die Farbe heller als Schwarz und entwickelt einen Blaustich. Das metallische Finish sorgt für einen eleganten Auftritt, der Leistung und moderne, schlichte Raffinesse zum Ausdruck bringt.","https://player.vimeo.com/video/1130913892?h=c6584347b1","#151921",[2927],"C4","basaltschwarzmetallic","/assets/pts/studio_C4.jpg?h=99a932ad58b9f1bc6604ee0c760475f6",[2842,2902],"Natürliche Schönheit: basaltschwarzmetallic ist ein natürlich wirkender Farbton, der ab Ende der 1990er Jahre für die Modellreihen 911, 718, Cayenne und Panamera angeboten wurde. Der Metallicfarbton geht auf die Färbung des vulkanischen Gesteins Basalt zurück, der eine dunkelgraue bis schwarze Farbe aufweist.<br><br>Basaltschwarzmetallic ist ein metallisches Schwarz, das bei bestimmten Lichtverhältnissen von einem hellen Grau bis zu einer dunklen Holzkohle reicht und bläulich-violette Untertöne zum Vorschein bringen kann. Der Farbton wirkt stilvoll, unaufdringlich und modern.<br><br>Ende 2011 hat Porsche auf Basis des 911 Carrera (997.2) das Sondermodell Black Edition vorgestellt, das auf 1.911 Exemplare limitiert war. Das Modell war nur in zwei Farben erhältlich: in schwarz uni und basaltschwarzmetallic.","https://player.vimeo.com/video/1099289646?h=5a073a831b","#19191e",[2936],"D4","carbonstahlgraumetallic","/assets/pts/studio_D4.jpg?h=bbe02f3fe86f757538ffe069000dce58",[2842,2935],"Kraftvolle Sportlichkeit: der besondere Farbton carbonstahlgraumetallic wurde ursprünglich auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses umgesetzt und später ins Farbe nach Wahl Programm übernommen.<br><br>Carbonstahlgraumetallic ist eine typisch dunkelgraue Farbe, die von Kohlenstoffstahl inspiriert ist. Die Metallart sieht oft grau oder silbern aus und kann in seiner Metallicausführung ein graues, edelstahlähnliches Erscheinungsbild erzeugen. Dieses tiefe und gedämpfte Aussehen verleiht einen modern-industriellen Touch, es erzeugt gleichzeitig ein Gefühl von Stärke und Haltbarkeit.","https://player.vimeo.com/video/1097530866?h=27aec5ff11","TAG12","#31343a",[2944],"D2","carbongraumetallic","/assets/pts/studio_D2.jpg?h=1575964b2174376e68f0cc8fe5b047b3",[2842,2935],"Edle Edition: Porsche hat für die exklusive Panamera Sonderserie im Jahr 2012 auch die kühl wirkende Lackierung carbongraumetallic angeboten. Die Platinum Edition glänzt durch dezente Designelemente und kreiert ein stilvolles sowie zurückhaltendes Aussehen. Der Metallicfarbton ist modern, vielseitig und steht für einen technologischen Anspruch.<br><br>Als Farbe nach Wahl ist carbongraumetallic für alle Modellreihen verfügbar.<br><br>Carbongraumetallic ist eine dunkle sowie stimmungsvolle Farbe mit einem tiefen Grauton und beinhaltet einen dezenten braunen Unterton. Die beliebte Farbe carbongraumetallic erzeugt durch ihre Vielseitigkeit ein Gefühl von Leistung und Innovation.","https://player.vimeo.com/video/1205433929?h=e2e639f75b","#323030",[2952],"KH","vulkangraumetallic","/assets/pts/studio_KH.jpg?h=6d2f0f1b1f681b38480a94f4df86f6db",[2842,2935],"Moderne Dramatik: vulkangraumetallic ist ein tiefes Metallic-Grau, das seinen Namen von vulkanischen Gesteinsformationen ableitet, die oft ein ähnlich dunkles und mattes Finish haben. Der Farbton ist eine der vielen Dunkelgrau-Variationen bei Porsche, die in den letzten Jahren einen größer werdenden Kundenkreis erschließt.<br><br>Gestartet ist vulkangraumetallic Ende der 2010er Jahre als Serienfarbe auf dem Macan und wurde danach auch für den Panamera und Taycan angeboten. Seit dem Jahr 2021 gehört der Farbton zum Farbe nach Wahl Programm.<br><br>Vulkangraumetallic ist ein kühles, tiefes Grau mit blauen Untertönen, was der Farbe einen eleganten und modernen Look verleiht. Je nach den Lichtverhältnissen kann die Farbe metallisch wirken, was ihre Vielseitigkeit erhöht.","https://player.vimeo.com/video/1099295900?h=956cbb6bc4","#34343b",[2960],"H5","grigiogranitometallic","/assets/pts/studio_H5.jpg?h=d417a8218535b75122f6476c3fb104e1",[2842,2935],"Zeitlose Sportwagen-Leidenschaft: grigiogranitometallic wurde von Porsche auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und später ins Farbe nach Wahl Programm übernommen.<br><br>Grigiogranitometallic ist nach dem Gestein Granit benannt, der üblicherweise eine durchdringende graue Farbe aufweist. Als mittlerer bis dunkler Grauton verfügt grigiogranitometallic über einen leicht kühlen, blauen Unterton und vermittelt ein starkes Gefühl der Zeitlosigkeit.<br><br>Grigiogranitometallic ist eine eher neutrale Farbe, die durch die satte Farbintensität dunkler ist als viele andere Grautöne. Der Farbton wird auch als Ersatz für Schwarz eingesetzt, um ein weicheres und dezenteres Aussehen zu erzielen.","https://player.vimeo.com/video/1099300095?h=b1cc50d7c0","#35353c",[2968],"EF","schiefergrau6601","/assets/pts/studio_EF.jpg?h=64e27770eed599c567095a926d7fb1df",[2935,2852],"Der Film-Star: schiefergrau6601 ist ein attraktiver und historischer Porsche Grauton, der als „Schiefergrau“ unter dem Farbcode 6601 auf dem 911 und dem 912 in den Jahren 1966 bis 1967 verfügbar war. „Schiefergrau“ erinnert an den natürlichen Schieferstein und ist eine der sieben Serienfarben des 356 B, der bis Ende der 1960er Jahre wechselnde Farbcodes aufweist. So beinhaltet der Farbcode R 741 für die anschließenden Modelljahre die Ausführungen 6001, 6201 und 6401, der dann auch für den 911 sowie den 912 übernommen wurde.Von 1968 bis 1969 ist die Farbe mit dem Code 6801 verfügbar und ist in den 2000er Jahren wiederkehrend bis 2019 auf dem 911 zurück.<br><br>Schiefergrau6601 ist ein neutraler nicht-metallischer Graufarbton mit einem leichten blauen oder grünen Unterton, der ein einfaches und zugleich anspruchsvolles Aussehen verleiht. Als klares, gedämpftes Grau verfügt der Farbton über eine leicht matte Oberfläche, die ein unaufdringliches ruhiges Aussehen verleiht.<br><br>Der 911 S 2.2. in „Schiefergrau“ aus dem Jahr 1971 ist das Fahrzeug aus dem Film „Le Mans“, den Hollywood-Schauspieler Steve McQueen gefahren hat. Das Filmfahrzeug ist am 20. August 2011 für den Rekordpreis von 1,38 Millionen USD verkauft worden. Privat hat der Schauspieler ein ähnliches Modell besessen.","https://player.vimeo.com/video/1097528721?h=8bb36fe522","#333433",[2976],"TH","grigioscuro","/assets/pts/studio_TH.jpg?h=13da6acd930ca44d2ffa8f3ff0963bc9",[2935,2852],"<p>Understatement mit Präsenz: grigioscuro ist ein tiefes Dunkelgrau mit klarer, moderner Ausstrahlung – ein Farbton, der bewusst zurückhaltend wirkt und dennoch souverän auftritt.</p><p><br></p><p>Er wurde auf Kundenwunsch im Rahmen des Porsche Farbe nach Wahl Plus Prozesses nachgestellt und verbindet technische Präzision mit einer eleganten, zeitlosen Tiefe. Je nach Lichtsituation verändert sich die Wirkung des Tons spürbar: bei direkter Sonneneinstrahlung erinnert grigioscuro an dunklen Schiefer und zeigt einen ganz dezenten grün‑braunen Unterton. Im Schatten hingegen präsentiert sich die Farbe als sattes, ruhiges Dunkelgrau, das eine beeindruckende optische Tiefe entwickelt.</p><p><br></p><p>Grigioscuro wirkt samtig und sehr klar, wodurch die Formensprache des Fahrzeugs besonders präzise zur Geltung kommt.</p><p><br></p><p>Das Ergebnis: ein perfekter Farbton für Kunden, die einen souveränen und zurückhaltend kraftvoller Auftritt lieben.</p>","https://player.vimeo.com/video/1163940020?h=5b67a45720","#393b39",[2983],"H3","grauschwarz","/assets/pts/studio_H3.jpg?h=0e86f98f566078ad2dd09c90235c1219",[2935,2852],"<p>Zurückhaltender Akzent: grauschwarz ist ein dunkler Farbton, der an Gewitterwolken, Schatten sowie bestimmte Gesteins- und Mineralarten in der Natur erinnert. Die Farbkombination der neutralen Farben Grau und Schwarz kann vielseitig kombiniert werden, da grauschwarz über eine zurückhaltende Ausstrahlung verfügt. Die klare, nicht-metallische Farblackierung ähnelt optisch dem schiefergrau6601, hat in seiner Farbnuance aber einen warmen Unterton.</p><p><br></p><p>Anfang der 2010er Jahre konnte grauschwarz auf dem Boxster und dann auch auf dem 911 gewählt werden.</p><p><br></p><p>Grauschwarz ist eine klare Farbe und gleicht eher der Farbe dunkelanthrazit. Doch der graue Unterton sorgt für einen jeweils anderen Akzent, der sich bei unterschiedlichen Lichtverhältnissen bemerkbar macht.</p>","#353437",[2991],"H1","graphitgrau","/assets/pts/studio_H1.jpg?h=1062619c078421fe4e9a61d588a76995",[2935,2852],"Modern, natürlich und schön: graphitgrau ist eine dunkle, geschmackvolle Farbe, die auf Graphit-Metalleffekt des 356 A zurückgeht. Das kühl wirkende graphitgrau ist den Grautönen des Graphits nachempfunden und spiegelt eine angenehme Art von natürlicher Leichtigkeit wider.<br><br>Graphitgrau ist ein dunkler Grauton mit einem tiefgründigen Finish, das je nach Lichtverhältnissen eine anspruchsvolle Atmosphäre verleiht. Die Farbe wird häufig im Automobil- und Industriedesign sowie in der Mode- und Innenarchitektur verwendet, weil graphitgrau mit Eleganz, Modernität und Professionalität verknüpft wird. Graphitgrau ist vielseitig und erzeugt einen auffälligen Kontrast, wenn es mit Weiß oder leuchtenden Farben kombiniert wird.<br><br>2014 hat Porsche das „50 Jahre 911 Jubiläumsmodell“ in schwarz uni sowie in den Sonderfarben graphitgrau uni und geysirgraumetallic aufgelegt. Die Sonderedition mit einer limitierten Stückzahl von 1963 Exemplaren verfügt beim 911 Carrera S über 400 PS (294 kW) und lässt durch die Ausstattungsmerkmale die Faszination Sportwagen aufleben, die zur 50-jährigen Erfolgsgeschichte beigetragen haben.","https://player.vimeo.com/video/1097459918?h=7e40e46a54","#3b3c3d",[2999],"A9","alexgrey","/assets/pts/studio_A9.jpg?h=5710b010891c71f8ca2c650c8d640e7d",[2935,2852],"Was die Polizei erlaubt: alexgrey ist speziell für die 911 Targa 4S Exclusive Alex Edition (991.2) im Jahr 2017 im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt worden. Die Edition ist eine Hommage an den in den Niederlanden bekannten Porsche Polizeistreifenwagen, der den Funkrufnamen \"Alex\" trägt. So entstand die Idee, den beliebten 911 Targa der niederländischen Nationalpolizei neu zu interpretieren.<br><br>In Zusammenarbeit mit dem Porsche Importeur Pon, dem niederländischen Designer Piet Boon und Style Porsche haben die Experten der Porsche Exclusive Manufaktur ein neues Farbkonzept entwickelt, das historische Designelemente des 911 „Alex“ auf die damals aktuelle Generation des 911 Targa 4S (991.2) projiziert.<br><br>Alexgrau ist ein unaufdringlicher und dennoch raffinierter dunkler Grauton mit einem gelblichen oder bräunlichen Unterton. Die eigens kreierte Farbe unterstreicht die Individualität und Exklusivität dieses Fahrzeugs, die das historische Vorbild-Fahrzeug auf unverwechselbare Weise widerspiegelt.","https://player.vimeo.com/video/1099309401?h=81a2fc8006","#47453f",[3007],"KI","parliamentgreymetallic","/assets/pts/studio_KI.jpg?h=1a1c7c8e1c3f3ba36b05530416a6d7b4",[2842,2935],"Kultiviert: parliamentgreymetallic ist ein warmer sowie gedämpfter Grauton, der an den traditionellen Stein erinnert, der in der Architektur des Londoner Stadtbezirks Westminster mit seinen Sehenswürdigkeiten und historischen Wahrzeichen verwendet wird.<br><br>Die Farbe wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses umgesetzt und später ins Farbe nach Wahl Programm übernommen.<br><br>Parliamentgreymetallic ist eine weiche und dezente Farbe mit einem leicht kühlen bläulichen oder grünlichen Unterton, der ein ruhiges Aussehen verleiht. Die zeitlose, elegante Farbe ruft Gefühle von Ruhe, Würde sowie Stabilität hervor.<br><br>In einem einmaligen Projekt haben im Jahr 2022 Porsche Motorsport und die Spezialisten der Porsche Exclusive Manufaktur eine 911 GT3 Straßenversion in Anlehnung an den 911 GT3 Cup im Jubiläumsdesign gestaltet. Der „911 GT3 – 30 Jahre Porsche Supercup“ ist mehrfarbig lackiert. Kein einziges Detail am Fahrzeug ist foliert. Die insgesamt acht Farben – darunter auch parliamentgreymetallic - sind allesamt lackiert, ebenso die goldfarbenen Namen der Supercup-Gewinner.","https://player.vimeo.com/video/1097753263?h=93b0f7e33c","#54545a",[3015],"E9","dolomitgraumetallic","/assets/pts/studio_E9.jpg?h=20932777a192aa79b46d95afcf5ba47d",[2842,2935],"Überraschend vielseitig: dolomitgraumetallic ist vor allem als Porsche Farbe der 1970er Jahre bekannt. Der gedämpfte Grauton ist schlicht und nach dem Mineral Dolomit benannt, einem Karbonatgestein. Dolomitgraumetallic kann als einfaches Grau beschrieben werden, das einen eleganten wie raffinierten Eindruck hinterlässt.<br><br>Dolomitgraumetallic ist ein mittleres bis dunkles Grau mit subtilen Anklängen an blaue und grüne Untertöne. Der Farbton vermittelt ein sehr warmes Gefühl.","https://player.vimeo.com/video/1098224825?h=0cb8568c08","#373b3e",[3022],"H6","grigiotelestometallic","/assets/pts/studio_H6.jpg?h=cfb155c08145fb218249b6edca872462",[2842,2935],"<p>Ausnahmestellung: grigiotelestometallic ist ein markant wirkender grauer Farbton, der nach einer Vulkangesteinsart benannt ist. Grigiotelestometallic betont durch die schimmernde Farboberfläche besonders die Kanten und Kurven der Top-Modelle moderner Sportwagen. </p><p><br></p><p> Die Farbe wurde auf Kundenwunsch von Porsche im Farbe nach Wahl Plus Prozess entwickelt und ist später ins Farbe nach Wahl Programm übernommen worden. </p><p><br></p><p> Im Vergleich zu anderen Metallic-Farben verleiht grigiotelestometallic ein gedämpfteres Aussehen, was durch den leicht warmen und bräunlichen Unterton hervorgerufen wird. Das tiefe Grau kreiert einen unverwechselbaren Look und kann vielseitig mit anderen Tönen kombiniert werden.</p>","#424448",[3029],"WC","arktikgrau","/assets/pts/studio_WC.jpg?h=76a45f250fde657796e368af24c4c1c3",[2935,2852],"Ästhetisch, kraftvoll, modern: arktikgrau ist eine unaufdringliche Farbe, die erstmals mit den Hochleistungsmodellen 718 Cayman GT4 RS (982) und dem Cayenne Turbo GT eingeführt wurde.<br><br>Der Farbton kreiert einen modernen Look und findet sich durch seine Vielseitigkeit auch in der Innenarchitektur und der Modewelt wieder.<br><br>Arktikgrau ist eine helle und gedämpfte Farbe, die inspiriert ist von dem beliebten Graphitblau und dem neueren Grauton-Trend. Es ist etwas dunkler als kreide und erinnert an das historische schiefergrau. Arktikgrau ist ein modernes Grau, welches an die eisigen Landschaften der arktischen Region erinnert und cool, raffiniert und trotzdem unaufgeregt zugleich wirkt.","#565b62",[3037],"EH","schiefergrau7015","/assets/pts/studio_EH.jpg?h=0a4bb1d926de85016db180b900b54a1b",[2935,2852],"Modern, dezent und elegant: schiefergrau7015 ist die hellere Farbversion von „Schiefergrau“ und erinnert an die Farben des natürlichen Schiefersteins.<br><br>Schiefergrau7015 ist ein dunkler, kühler Grauton mit einem leicht bläulichen Unterton. Die Farbe strahlt Stabilität, Zuverlässigkeit und eine zeitlose Eleganz aus. Der Farbton wird häufig im Industrie- und Architekturdesign gewählt und hier für Metalldächer, Gebäudefassaden und Fensterrahmen sowie für die Automobil- oder Luftfahrtherstellung eingesetzt.<br><br>Schiefergrau7015 wirkt auf allen Porsche Fahrzeugen gedämpft und satt.<br><br>Schiefergrau7015 dient auch als Inspiration für die Porsche Serienfarbe schiefergrau neo, eine Farbe, die Tradition mit Moderne gekonnt miteinander verbindet.","https://player.vimeo.com/video/1099304886?h=560d14be4a","#4e4f55",[3045],"L8","meteorgraumetallic","/assets/pts/studio_L8.jpg?h=990f8a6b3ceef5cfbe981841703fa0c5",[2842,2935],"<p>Moderne Kühnheit: meteorgraumetallic ist ein Mittelgrauton, der sich von der intensiven Farbe eines metallischen Meteoriten ableitet. In ihrer Wirkung ähnelt meteorgraumetallic den Farben von Gewitterwolken oder Schiefer. Seit 2006 ist meteorgraumetallic für die Modelle 911 (997), 718 (986 und 987) sowie den Cayenne im Farbangebot vertreten.</p><p><br></p><p>Meteorgraumetallic ist ein kühler und moderner Grauton mit einem subtilen bläulichen Unterton. Die mittelgraue Farbe erzeugt ein anspruchsvolles Erscheinungsbild mit Tiefe und Textur, kann je nach Lichtverhältnissen und Umgebungsfarben eine unterschiedliche Wirkung erzielen. Der Farbton ist vielseitig und wird als neutrale Basis in vielen Designanwendungen verwendet, da sich meteorgraumetallic gut mit neutralen, leuchtenden oder Pastellfarben kombinieren lässt.</p>","https://player.vimeo.com/video/1097547259?h=56e8f6072e","#656567",[3052],"D5","chinagrey","/assets/pts/studio_D5.jpg?h=a70ac46de17c83c7acc7276540d9d7e1",[2935,2852],"Zeitgenössisches Statement: die Farbe chinagrey ist ein zeitloser und edler Grauton, der ein Gefühl von sportlicher Gelassenheit hinterlässt.<br><br>Die Farbe wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und ist heute als Farbe nach Wahl Option verfügbar.<br><br>Chinagrey ist ein kühler Grauton mit einem dezenten braunen und grünen Unterton. Der Farbton verkörpert Kraft, Eleganz und Charakter und wird gerne von Kunden gewählt, die mit ihrer Farbwahl für einen starken, lässigen und zugleich modernen Auftritt sorgen möchten.","#525355",[3059],"JI","steingraumetallic","/assets/pts/studio_JI.jpg?h=b2653b6a1265c7bc5eca48b9019f2868",[2842,2935],"Besonnenheit und Stärke: steingraumetallic ist eine historische Porsche Farbe, die der Sportwagenhersteller seit den 1980er Jahren immer wieder angeboten hat. Der Farbton ist ein kühler und neutraler Grauton, der an Natursteine wie Granit oder Schiefer erinnert sowie zusätzlich über einen metallischen Glanz verfügt.<br><br>Seit 1985 ist steingraumetallic unter dem Farbcode LY7U für die Modelle 924 und 944 verfügbar. Es folgen ab 1989 die Modelle 911, 928 und 964 mit dem Farbcode 693.<br><br>Bei steingraumetallic handelt es sich um einen mittel- bis dunklen Grauton mit einem anspruchsvollen metallischen Finish, der kaum oder keine Untertöne anderer Farben aufweist – das charakterisiert die Farbe zu einem echten Neutralton. Auf den ersten Blick hat der kühle Graufarbton Ähnlichkeit mit GT-silbermetallic, doch steingraumetallic ist wesentlich dunkler und eher eine Grau- als eine Silberfarbe. Auch ist der Farbton nicht zu verwechseln mit dem nicht-metallischen Steingrau, das einen stärkeren grünen Unterton aufweist.","#7d7b7a",[3067],"M7","nardograu","/assets/pts/studio_M7.jpg?h=259daabfae8414580895a405467bdd50",[2935,2852],"Renommiert und modern: nardograu ist ein dezenter Grauton, der mit einem unverwechselbaren matten Finish überzeugt. Die Herkunft von Farbname und -ton sind im süditalienischen Testgelände Nardò Technical Center (NTC) zu finden, die Porsche im Jahr 2012 erworben hat. Die Hochgeschwindigkeitsstrecke ermöglicht durch ihre spezifischen Sektionen, Fahrzeugentwicklung und -prüfung auf höchstem Niveau zu betreiben. Die Asphalt- und Betonfärbung des bekannten Nardò-Rings ähnelt der gewählten Fahrzeug-Außenfarbe.<br><br>Die Farbe nardograu stammt ursprünglich von Audi und geht auf das Jahr 2013 zurück.<br><br>Nardograu ist ein kühler Grauton mit einem leichten Blau- oder Grünstich. Die Farbe wirkt nicht unmittelbar auffällig, sie bringt ein anspruchsvolles Aussehen dezent zum Vorschein.","https://player.vimeo.com/video/1097822169?h=58a5c03dec","#5f6062",[3075],"X8","goodmangrau","/assets/pts/studio_X8.jpg?h=707634adf4d006b32d33dfb39f3ffa5e",[2935,2852],"Mit eigenem Code: goodmangrau ist, wie der Name vermuten lässt, ein sehr besonderer Graufarbton, dessen Entwicklung auf die 1990er Jahre zurückzuführen ist. Ron Goodman, ein passionierter Autoenthusiast, wollte seinen neu erworbenen 356er Rennwagen damals in der Farbe perlrot lackieren lassen. Als er das Fahrzeug jedoch in der grauen Grundierung erblickte, war eine neue Idee geboren: die außergewöhnliche Optik sollte als Lackfarbe entwickelt werden.<br><br>Im Jahr 2023 hat Porsche die Farbe goodmangrau auf persönlichen Wunsch von Ron Goodman über den Farbe nach Wahl Plus Prozess nachgestellt. Der Lack erinnert an den Farbton von grundierten Fahrzeugen, hat jedoch eine außergewöhnlich tiefe Wirkung und lässt die Oberfläche des Fahrzeugs sehr klar und glasartig erscheinen.<br><br>Für Ron Goodman ist es etwas ganz Besonderes, dass der Farbton nach dem Ideengeber benannt ist und einen eigenen Porsche-Farbcode trägt. Zu sehen, dass andere Autoenthusiasten diese Außenfarbe für ihr Fahrzeug wählen, würde Ron sehr stolz machen.","https://player.vimeo.com/video/1097464327?h=e711155e22","#5d6163",[3083],"JG","steingrau","/assets/pts/studio_JG.jpg?h=a86a1d2342caaf84b652d331731700a8",[2935,2852],"Lifestyle trifft Charakter: steingrau ist eine historische Porsche Farbe und eine der ersten vier Sonderfarben des 356A aus dem Jahr 1957 mit dem Farbcode 5710 oder Reutter 710. Ende der 1960er Jahre kehrt steingrau für den 911 und den 912 unter dem Farbcode 75741 zurück. Der Farbton erinnert an Natursteine wie Sandstein, Granit oder Kalkgestein.<br><br>Steingrau kann als mittelgrauer Farbton beschrieben werden, der einen grünlich-beigefarbenen Unterton aufweist. Steingrau wird gerne in Kombination mit einer roten Innenausstattung gewählt.<br><br>Zum 90. Jubiläums des Hockenheimrings hat Porsche 2022 die Taycan GTS Hockenheimring Edition in der klassisch-zeitlosen Farbe steingrau vorgestellt.","https://player.vimeo.com/video/1099309840?h=7e395dc322","#888269",[3091],"TF","beigegrau","/assets/pts/studio_TF.jpg?h=546cad69666ca47e3cd88cd937d407cb",[2935,2852],"<p>Klar und Puristisch: Beigegrau ist eine historische Porsche Farbe, die bereits Mitte der 1960er Jahre im Farbsortiment des Sportwagenherstellers zu finden war. Der fein ausbalancierte Farbton verbindet die warme Natürlichkeit von Beige mit der kühlen Eleganz von Grau.</p><p><br></p><p>Bei Sonneneinstrahlung wirkt beigegrau weich, hell und cremig, im Schatten elegant und beinahe architektonisch, da der dezente Grauton stärker hervortritt.</p><p><br></p><p>Beigegrau ist keine laute Farbe – sie lässt Form, Linien und Proportionen sprechen. Gleichzeitig sorgt die warme Grundnote dafür, dass der Farbton nicht kühl oder technisch wirkt, sondern eine einladende, authentische Ausstrahlung besitzt. Beigegrau beweist damit, wie kraftvoll eine vermeintlich schlichte Farbe sein kann: neutral, zeitlos, hochwertig und im besten Sinne zurückgenommen, mit einer harmonischen Balance aus Wärme und Klarheit.</p><p><br></p><p><br></p>","https://player.vimeo.com/video/1163939977?h=51bd5df1b6","#a49b7e",[3099],"G3","geysirgraumetallic","/assets/pts/studio_G3.jpg?h=329545310e8b60dde8f3742a47647009",[2842,2935],"Phänomenal: geysirgraumetallic ist ein mittelgrauer Lack, der sich farblich und namentlich am gesteinsreichen Umfeld eines Geysirs anlehnt. Die dort vorkommenden Mineralien und Felsen haben eine ähnlich hellgraue Färbung.<br><br>Geysirgraumetallic ist ein kühles Grau mit einem leichten blauen oder grünen Unterton. Es handelt sich nicht um eine besonders dunkle oder helle Farbe, sondern eher um einen mittleren Grauton, der elegant und zurückhaltend wirkt. Bei manchen Lichtverhältnissen kann geysirgraumetallic eine leicht perlmuttartige Oberfläche entfalten, die zu einer Vielzahl von Stilrichtungen passt.<br><br>2014 hat Porsche das „50 Jahre 911 Sondermodell“ in den spezifischen Sonderfarben graphitgrau uni und geysirgraumetallic sowie in schwarz uni aufgelegt. Die Sonderedition mit einer limitierten Stückzahl von 1963 Exemplaren verfügt beim 911 Carrera S über 400 PS (294 kW) und lässt durch die Ausstattungsmerkmale die Faszination Sportwagen aufleben, die zur 50-jährigen Erfolgsgeschichte beigetragen haben.","https://player.vimeo.com/video/1097493078?h=12cd4e891d","#bdb9a3",[3106],"M3","modegrau","/assets/pts/studio_M3.jpg?h=bf2815132dcae1a53fc771f21f72c04f",[2935,2852],"Das Statement: modegrau gehört zu den ersten Porsche Farben, die 1950 auf dem 356 unter dem Farbcode R531 verfügbar waren. Mit den Jahren taucht modegrau immer wieder auf und dient als Inspiration für den Farbton sportclassicgrau aus dem Jahr 2009. Modegrau wird verwendet, um einen eleganten Look sowie eine legere und entspannte Atmosphäre zu kreieren. Der Farblack ist eine schicke und kultivierte Farbe, die Selbstvertrauen, Klasse und Vornehmheit ausstrahlt.<br><br>Modegrau ist ein kühler Grauton, der oft mit Eleganz und Stil assoziiert wird. Es ist ein mittlerer Farbton mit einem leicht blauen oder violetten Unterton, der ein modernes und zeitgenössisches Aussehen verleiht. Die Farbe wird häufig in der Mode und im Innendesign verwendet, da sie gut mit einer breiten Palette von Farben und Materialien harmoniert.","#898987",[3114],"DD","964polarsilbermetallic","/assets/pts/studio_DD.jpg?h=5c3a58fb5a1dd8d24c1bb3e872fccacf",[2842,2935],"High-end in dezent: mit 964polarsilbermetallic ist ein glänzender Auftritt garantiert, da der dezente Farbton ein elegantes und anspruchsvolles Aussehen zum Ausdruck bringt.<br><br>In den 1990er Jahren ist die Farbe auf 928, 968 und dem 911 auch bis in die 2000er Jahre angeboten worden, genauso beim Porsche Boxster sowie im Jahr 2007 auch beim Cayman.<br><br>964polarsilbermetallic ist eine Farbe mit einem kühlen, silbrig-weißen Aussehen, das je nach Lichteinfall auch einen leichten Blau- oder Graustich aufweist. Der Farbton erinnert damit an gefrorenes Wasser, wie am Polarkreis.<br><br>Als Serienfarbe ziert „polarsilbermetallic“ neben „violametallic“ das Sondermodell „30 Jahre 911“ aus dem Jahr 1993. Die allradgetriebene Carrera 4-Variante des 964 ist auf 911 Stück limitiert und verfügt über eine breite Turbo-Karosserie.","https://player.vimeo.com/video/1097516265?h=9575cf128e","#b9bfcb",[3122],"F6","fischsilbergraumetallic","/assets/pts/studio_F6.jpg?h=55b1e7c0b34ec5ae303df2a7fe62a3eb",[2842,2935],"Dezentes Glänzen: der etwas sperrig-klingende Farbton fischsilbergraumetallic ist keine Modeerscheinung, sondern eine moderne Interpretation der historischen Porsche Farbe „Fischsilbergrau“, der Farbe einer der ersten beiden Porsche 356, die 1951 nach Australien importiert wurden.<br><br>Siebzig Jahre später stellt Porsche Cars Australia 2021 anlässlich des 70-jährigen Bestehens ein besonderes Highlight vor: die limitierte 911 GT3 70 Years Porsche Australia Edition (992) in fischsilbergraumetallic. Die Farbe wird im Farbe nach Wahl Plus Prozess entwickelt und später ins Farbe nach Wahl Programm übernommen.<br><br>Die Farbe fischsilbergraumetallic ist ein kühler und gedämpfter Grauton mit einem leichten Metallschimmer, der an die Schuppen bestimmter Fischarten erinnert. Der reflektierende Silberton hat einen dezent ausgeprägten Blau- bis Grünstich, der ein angenehmes Gefühl der Ruhe vermittelt.","https://player.vimeo.com/video/1097461496?h=c1db0b2a63","#8c9492",[3130],"E7","delfingrau","/assets/pts/studio_E7.jpg?h=994c23bdb7c43844d1d637ec56726d2f",[2935,2852],"Historisch ruhige Atmosphäre: delfingrau ist ein selten gewählter Grauton, der im Aussehen an die Graufärbung von Delfinen erinnert. Der kühle Farbton geht bei Porsche auf das Modell 356 zurück.<br><br>Delfingrau gehört schon Anfang der 1960er Jahre zu den ersten Sonderfarben des Sportwagenherstellers. Auch auf den Modellreihen des 911 und des 912 konnte delfingrau als Sonderfarbe ausgewählt werden.<br><br>Die frühe 356er Farbe delfingrau ist ein heller Grauton mit einem leichten blauen und grünen Unterton, der eine beruhigende Wirkung verleiht. Je nach Lichtverhältnissen kann die Farbintensität von einem sehr hellen Grau bis hin zu Mittelgrau variieren. Der Farbton wirkt anspruchsvoll und strahlt dennoch zugleich Ruhe aus.","https://player.vimeo.com/video/1099298859?h=78e3bc195c","#a7aba6",[3138],"H4","grigiocampovolo","/assets/pts/studio_H4.jpg?h=921596de8e2d68651948d87401a7d391",[2935,2852],"Anspruchsvolle Note: grigiocampovolo ist, wie der Name anklingen lässt, eine klassische Farbe mit historischem Bezug zu Italien. Die Farbe ist vermutlich nach einer Rennstrecke in Italien benannt und wird häufig bei Hochleistungssportwagen verwendet, weil der Farbton die Karosserieform betont.<br><br>Grigiocampovolo wurde auf persönlichen Wunsch eines Kunden im Farbe nach Wahl Plus Prozess entwickelt und ist heute im Farbe nach Wahl Programm verfügbar.<br><br>Die Farbe ist ein mittleres Grau mit einem leichten Blau- oder Grünstich, der ein Gefühl von Kraft und Geschwindigkeit zu vermitteln versucht.","https://player.vimeo.com/video/1099305334?h=b4c8de1724","#9b9ea0",[3146],"WF","dolomitsilbermetallic","/assets/pts/studio_WF.jpg?h=fd35634428086921b5bb9323a46f56a7",[2842,2935],"Kühle Schönheit: die Farbe dolomitsilbermetallic ist ein besonderer Vertreter der äußerst beliebten Porsche Farbe silber. Das metallische Silber wirkt sehr ästhetisch, weil es im Licht einen einzigartig glänzenden Effekt erzielt und oft mit Technologie, Fortschritt und Modernität gleichgesetzt wird.<br><br>Dolomit ist eine Art von Mineralgestein, das einen speziellen Schimmer aufweist – von Elfenbein über Perlmutt bis ins gräuliche hinein.<br><br>Dolomitsilbermetallic ist bei Porsche als Serienfarbe gestartet und gehört seit 2024 auch zum Farbe nach Wahl Programm.<br><br>Die metallische Silberfarbe weist im Gegensatz zum wärmer wirkenden GT-silbermetallic einen kühlen und blauen Unterton auf. Dolomitsilbermetallic ist ein schön anzusehendes metallisches Silber, das im Licht hell erstrahlt und sich auch bei dunklen Witterungsverhältnissen nicht versteckt. Ein wahrer Blickfang.","https://player.vimeo.com/video/1096902186?h=8cea3b102f","#a3a9ad",[3154],"FY","sportclassicgrau","/assets/pts/studio_FY.jpg?h=35e039af719dc7d4f62f004c98ecef67",[2935,2852],"<p>Exklusiver Trendsetter: sportclassicgrau ist ein mittlerer Grauton, der speziell für den 911 Sport Classic (Typ 997) entwickelt wurde – einem Porsche in limitierter Auflage von 250 Fahrzeugen, der 2010 auf den Markt kam.</p><p><br></p><p>Schon damals ist nach der Veröffentlichung der Farbtrend zu Grautönen avanciert, der bei der Serienfarbe kreide eine bis zu 30 Prozent höhere Nachfrage generierte. Bei beiden Sport Classic-Modellen dient modegrau des 356 als Inspirationsquelle für die Farbentwicklung.</p><p><br></p><p>Sportclassicgrau kann als Blaugrau oder Schiefergrau beschrieben werden und ist eine anspruchsvolle wie dezente Farbe, die ein Gefühl von Eleganz, Vornehmheit sowie zeitlosem Stil vermittelt.</p><p><br></p><p>Im September 2009 ist der 911 Sport Classic (997) in sportclassicgrau auf der IAA in Frankfurt am Main vorgestellt worden und ist nach bereits 48 Stunden ausverkauft gewesen.</p>","https://player.vimeo.com/video/1097513594?h=eb62eb6ddb","#92989a",[3162],"NP","centenairesilber","/assets/pts/studio_NP.jpg?h=010160f4d64336abb900d068d81a93b3",[2842,2935],"Prestigeträchtig und legendär: centenairesilber ist die ikonische Verbindung von Porsche zum 24-Stunden-Klassiker an der Sarthe. Zum 100-jährigen Bestehen des Langstreckenrennens im Jahr 2023 und dem 75-jährigen Jubiläum der Marke, hat Porsche den Farbton im Farbe nach Wahl Plus Prozess speziell für die Marktedition 911 Carrera GTS Le Mans Centenaire Edition entwickelt. Als Inspiration hat das Le-Mans-Siegerauto 356 SL aus dem Jahr 1951 gedient, das damals in der Außenfarbe silber lackiert war.<br><br>Der neu kreierte Farbton ist heller als das bekannte GT-silbermetallic und ruft automatisch Erinnerungen zum Kern der Marke im Motorsport hervor.<br><br>Centenairesilber ist eine leidenschaftliche Hommage an das größte Langstreckenrennen der Welt. Porsche zollt mit der Farbe auch dem eigenen Engagement im Langstreckensport Tribut und ermöglicht den Sportwagenfans, in eine ganz persönliche Verbindung zum prestigeträchtigsten Motorsport-Rennen der Welt einzugehen.","https://player.vimeo.com/video/1097465358?h=6c2cc38099","#b9baba",[3171],"NR","mondstein","/assets/pts/studio_NR.jpg?h=7fe1cbaede02c91e30c9b294add0e504",[2852,3170],"Mystisch und selten: mondstein ist eine einzigartige Neuinterpretation der historischen Porsche Farbe Flieder aus den späten 1970er Jahren, die nur auf wenigen Modellen von 924, 928 und 911 zu finden ist.<br><br>Name und Farbton sind an den gleichnamigen Edelstein angelehnt, der durch eine milchige, schillernd-weißgräuliche Farbe charakterisiert ist und einen violetten Adulareszenz-Effekt aufweist. Dieser schimmernde Lichteffekt wird durch die Reflexion sowie Streuung des Lichts verursacht und entsteht in der inneren Struktur des Steins.<br><br>Der lilafarbene Unterton in mondstein wirkt mild und kreiert bei Sonneneinstrahlung eine schöne, schillernde Dynamik.","https://player.vimeo.com/video/1096895775?h=98da8b91ee","TAG4","#b7b5c5",[3178],"WI","frozenberrymetallic","/assets/pts/studio_WI.jpg?h=de29e885394b697d0b1d6197cd31be54",[2842,3170],"Elektrisierend schön: passend zur Modellerweiterung im Jahr 2021 hat der Porsche Taycan mit frozenberrymetallic auch seine eigene Farbe erhalten. Der unverkennbare Roséfarbton hat zunächst als Serienfarbe Premiere gefeiert und ist seit dem Jahr 2024 im Farbe nach Wahl Programm bestellbar.<br><br>Frozenberrymetallic ist ein pastelliges Rosa mit einem Hauch von blauen Untertönen, das zart und sehr sanft wirkt und an das historische Cassis-Rot aus den 1980er Jahren erinnert.","#826e70",[3185],"JJ","sternrubin","/assets/pts/studio_JJ.jpg?h=b58568e5b58f3b139b837f477fb20f2f",[2852,3170],"<p>Kultivierte Entschlossenheit: sternrubin ist ein auffälliger und tief gesättigter Rosafarbton, der sich am gleichnamigen Farbedelstein orientiert. Rubin ist als roter Edelstein bekannt, die Farbvielfalt reicht aber von rosa bis purpurrot. Rosa Rubine weisen einen hohen Sättigungsgrad auf und können von einem blassen, fast rosa-orangen Farbton bis zu einem leuchtenden, kräftigen Rosa oder einem tiefen Rosarot reichen.</p><p><br></p><p>Sternrubin ist eine historische Porsche Farbe aus den frühen 1990er-Jahren, die sich als knallige Einführungsfarbe des legendären 911 Carrera RS 3.6 (964) zur Kultfarbe entwickelt hat. Obwohl der auffällige Farbton als polarisierend empfunden wird, ist sternrubin eine gefragte Farbwahl, die Frauen wie Männer gleichermaßen anspricht. Der Farbton wird im englischen als Rubystar bezeichnet, früher Ruby Stone, und ist unter dem Farbcode 82N /M3B für die Modelle 928, 944, 968 und 911 (964) verfügbar gewesen.</p><p><br></p><p>Sternrubin liegt zwischen den Violett und Rot Farbtönen, ist eine facettenreiche, kräftige und intensive Magenta Farbe, mit einem leichten kalten Unterton. Die einzigartige und attraktive Farbbrillanz symbolisiert Lebenskraft sowie Selbstvertrauen.</p><p><br></p><p>Ende 2022 hat Porsche mit Ruby Star Neo eine moderne Interpretation dieser Farbe auf den Markt gebracht, die als Sonderfarbe im Standardprogramm erhältlich ist.</p>","#7b1147",[3193],"UL","lorettapurple","/assets/pts/studio_UL.jpg?h=2ad43f80ecfb32a5ebbc5e6f2c5042aa",[2852,3170],"<p>Inspirierend lebendig: lorettapurple ist ein kräftiges Violett mit einer leichten Rot-Nuance, das aus der exklusiven Zusammenarbeit des Sportwagenherstellers mit dem amerikanischen Designer und Influencer Sean Wotherspoon entstanden ist: Ein Art Car bestehend aus 4 Farben: nashyblue, seanpeach, lorettapurple und ashleygreen.</p><p><br></p><p>Die Herkunft des Farbnamens lorettapurple hat dabei einen besonders persönlichen Bezug: Sean Wotherspoon widmete den Farbton seiner Tochter Loretta und verlieh ihm damit eine emotionale Tiefe, die weit über das Design hinausreicht.</p><p><br></p><p>Im Jahr 2026 wird die moderne Farbe lorettapurple in das Farbe nach Wahl Produktprogramm aufgenommen und kann von allen Porsche Liebhabern bestellt werden.</p>","https://player.vimeo.com/video/1163940155?h=b35cd294c4","#693065",[3201],"JZ","veilchenlilametallic","/assets/pts/studio_JZ.jpg?h=4cd9973715d7ab6629811cdd67e98d39",[2842,3170],"Unberührt und kreativ: veilchenlilametallic ist ein satter Violettton, dessen Name und Farbton von der Veilchenblüte inspiriert ist, die violette Blütenblätter trägt. Der Farbton geht auf die historische Porsche Farbe „Veilchenblau Metallic“ zurück, die unter den Farbcodes 37E und 3AF 1993 für 928, 964 und 968 angeboten wurde. Veilchenlilametallic ist nicht zu verwechseln mit violametallic, die wesentlich dunkler in ihrer Farbausführung ist.<br><br>Veilchenlilametallic ist ein tiefer, kühler Violettton, der je nach Intensität von dunkel und stimmungsvoll bis hell und kräftig reichen kann. Der Farbton weist charakteristisch blaue Untertöne auf, die veilchenlilametallic ein etwas kühleres und gedämpfteres Aussehen verleiht als anderen Violetttönen. Die Farbe wird oft mit Königlichkeit, Luxus und Kultiviertheit assoziiert. Speziell ist, dass sich veilchenlilametallic bei unterschiedlichen Lichtverhältnissen so verändern kann, dass der Farbton beinahe, wie eine ganz andere Farbe aussieht.","https://player.vimeo.com/video/1097754093?h=047b8cd19b","#6d5e97",[3209],"JU","ultraviolett","/assets/pts/studio_JU.jpg?h=2002c1ada6f1dac9324923047dd78b44",[2852,3170],"<p>Unkonventionell: ultraviolett ist ein nicht-metallisches, mittleres Violett und könnte als moderne Interpretation der Farbe Flieder aus den 1970er Jahren angesehen werden.</p><p><br></p><p>Der Begriff „Violett“ ist vom französischen Wort „Viola“ für Veilchen abgeleitet. Das Wort „Ultra“ steht für „hinausgehend“.</p><p><br></p><p>Ultraviolett verfügt über einen starken Charakter, der Wagemut, Freiheit und Originalität verkörpert. Die Farbe erzeugt einen einzigartigen und auffälligen visuellen Effekt, der starke Emotionen hervorrufen kann. Ultraviolett erregt Aufmerksamkeit, regt aber auch die Fantasie an.</p><p><br></p><p>Zur Markteinführung des 911 GT3 RS im Jahr 2015 ist ultraviolett als Kommunikationsfarbe gewählt worden.</p>","https://player.vimeo.com/video/1097537836?h=a1e41e8fa3","#312648",[3217],"NN","aubergine","/assets/pts/studio_NN.jpg?h=06ea2102141351da4c17b356fa65bf65",[2852,3170],"Die feine Nuance: aubergine ist ein dunkles, burgunderrotes Violett, das in seiner Anmutung Exklusivität verkörpert und dieses Empfinden auch ausstrahlt. Die Namensgebung geht auf den satten Farbton das Nachtschattengewächs der Aubergine zurück und ist eine historische Porsche Farbe, die auf den 911 Modellen der frühen 1970er Jahre zu finden ist.<br><br>Der Farbton aubergine hat eine eigene markante Tiefe, die von einem fast schwarzen Violett bis hin zu einem helleren und lebhafteren Farbmix reichen kann. Durch dieses nuancierte Erscheinungsbild bewirkt aubergine ein luxuriöses Gefühl von Dramatik und Kreativität.<br><br>Bekannter Vertreter ist der Verkaufsschlager 911 Carrera RS 2.7 aus dem Jahr 1973 – insgesamt 16 Fahrzeuge des puristischen Modells wurden in aubergine lackiert.","https://player.vimeo.com/video/1099298029?h=cccc620286","#311422",[3225],"B1","amethystmetallic","/assets/pts/studio_B1.jpg?h=f240228ad3495eb265aa79edc079de6e",[2842,3170],"<p>Elegantes Aufsehen: dstmetalie Farbe amethylic ist inspiriert von der klassisch-violetten Färbung des gleichnamigen Halbedelsteins Amethyst und verleiht jedem Design ein sattes, luxuriöses Aussehen. Der kräftige Farbton reicht von einem hellen Lavendel bis hin zu einem tiefen Violett und ist in Metallic-Ausführung seit Anfang der 1990er Jahre für die Modellreihen 911 und 928 verfügbar. Als Farbe nach Wahl ist amethystmetallic für alle Modelle erhältlich.</p><p><br></p><p> Der metallische Glanz verkörpert Eleganz und Opulenz, der Schimmereffekt erinnert an die Strahlkraft eines Edelsteins – zeitlos und zugleich raffiniert-auffällig.</p><p><br></p><p> Ein Fahrzeug in dieser Lackierung ist auch als Testimonial bekannt: auf einem Porsche Werbeplakat und einer Anzeige aus dem Jahr 1993 ist das Jubiläumsmodell „30 Jahre 911“ in amethystmetallic von hinten mit der Aufschrift „Seit über 100 Jahren machen Autos unabhängig. Eins macht abhängig.“ abgedruckt. Die allradgetriebene Carrera 4-Variante des 964 mit breiter Turbo-Karosserie ist auf 911 Stück limitiert und in drei Lackierungen verfügbar – neben amethystmetallic auch in der weiteren Serienfarbe polarsilbermetallic sowie exklusiv für den deutschen Markt in violametallic.</p>","https://player.vimeo.com/video/1097540691?h=3e08deccbe","#281926",[3232],"KC","violametallic","/assets/pts/studio_KC.jpg?h=7801ced5a2f73c998933e52e2253e0e1",[2842,3170],"Dramatische Schönheit: violametallic ist ein kräftiges Dunkelviolett mit einem fesselnden metallischen Glanz. Im Lateinischen steht „Viola“ für Veilchen, eine Pflanzengattung, die dunkle sowie satte violette Blütenblätter ausbildet.<br><br>Violametallic ist eine historische Porsche Farbe, die erstmalig 1993 angeboten wurde. Unter den Farbcodes 3AE und 39G sowie als „viola-perlcolor“ ist die Farbe für die 911 Modelle der Generationen 964, 993 und 996 im Angebot gewesen. Ende der 1990er Jahre folgt dann die Verfügbarkeit auf dem Boxster (986).<br><br>Violametallic ist ein mittlerer bis dunkler Farbton, der auch als edles und elegantes violett bezeichnet werden kann. Der metallische Effekt bewirkt Dynamik auf der Farboberfläche, wodurch ein einmaliges juwelenartiges Erscheinungsbild entsteht. Bei schwachen Lichtverhältnissen sieht der Farbton beinahe Schwarz aus.","#1e1928",[3241],"E6","dunkelsaphirmetallic","/assets/pts/studio_E6.jpg?h=f64d12382b9ebee9331d428c4a04bb32",[2842,3240],"Kostbare Rarität: dunkelsaphirmetallic hat eine tiefblaue Ausstrahlung und erinnert an den kostbaren Edelstein Saphir. Der Farbton strahlt eine kühle, beruhigende Wirkung aus und ist als Akzentfarbe eine beliebte Wahl für formelle Anlässe – so sind Abendkleider oder Anzüge durch den Schimmer-Effekt oft in dunkelsaphir gehalten.<br><br>Dunkelsaphirmetallic wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses von Porsche umgesetzt und ist heute als Farbe nach Wahl erhältlich.<br><br>Dunkelsaphirmetallic ist ein gesättigter Blauton, der sowohl als dunkel sowie auch als intensiv beschrieben werden kann. Die Farbe ist auffällig und elegant, sodass ein gewisser Luxusanspruch mit dunkelsaphirmetallic assoziiert werden kann. Das Farbspektrum liegt zwischen nachtblaumetallic und carbonschwarzmetallic.","https://player.vimeo.com/video/1098215130?h=ea526f0fd7","TAG10","#1b1e2c",[3249],"CN","ozeanblaumetallic","/assets/pts/studio_CN.jpg?h=043cf2a3f46c0ee76a299129be8e5c55",[2842,3240],"Inspirierend: ozeanblaumetallic ist ein lebendiger dunkler Blauton, der an die Farbe des Ozeans an einem klaren Tag erinnert. Als historischer Farbton gehört ozeanblaumetallic zu einer der neun ersten Metallic-Farben des Porsche Boxster (986), die zum Start der neuen Baureihe im Jahr 1996 verfügbar waren. Auch auf den zeitlich folgenden 911 Modellen (993, 996) ist die Farbe unter dem Farbcode 3AY vorhanden.<br><br>Ozeanblaumetallic ist ein tiefer und kräftiger Blauton mit einem leicht grünlichen oder blaugrünen Unterton. Auch durch die namentliche Verbindung zu Meer und Strand kann die Farbe eine belebende Atmosphäre kreieren, die für Energie, Vitalität sowie Abenteuer steht.","https://player.vimeo.com/video/1097437139?h=4adf605dae","#151d31",[3257],"M4","mondlichtblaumetallic","/assets/pts/studio_M4.jpg?h=22bd663b5b2722a88eea58c52665b30c",[2842,3240],"Romantische Stimmung: mondlichtblaumetallic ist ein dunkles Blau, das in seinem Namen den einzigartigen Farbglanz trägt. Der Nachthimmel hat bei Mondschein eine ganz eigene Stimmung, die in der Farbe mondlichtblaumetallic aufgegriffen wird. Der weiche und elegant wirkende Farbton hat eine schwärzliche Tönung, die eine entspannende wie ruhige Atmosphäre kreiert.<br><br>Mondlichtblaumetallic ist ein weicher, gedämpfter Blauton mit einem leicht gräulichen oder silbrigen Unterton. Die kühle Farbe strahlt Gelassenheit aus und ähnelt mit dem metallischen Glanz auch der Farbe des Himmels kurz vor einem Sonnenaufgang oder nach einem Sonnenuntergang.","https://player.vimeo.com/video/1097533453?h=4634dd1b81","#121720",[3265],"NW","xblau","/assets/pts/studio_NW.jpg?h=586f406fef98deae0857e52a0372a593",[3240,2852],"Das blaue Wunder: xblau ist ein speziell kreierter tief-satter Blaufarbton für die 2019 vorgestellte 911 Carrera 4S Belgian Legend Edition (992). Die Sonderedition ist anlässlich des 75. Geburtstags der belgischen Rennsportikone Jacky Ickx entstanden, wobei das Design der Farbe xblau passend zu seinem blau-weißen Rennhelm entwickelt wurde, seinem damaligen Markenzeichen.<br><br>Ursprünglich als Farbe nach Wahl Plus entwickelt, ist xblau heute als Farbe nach Wahl Option wählbar.<br><br>Der Farbton xblau ist ein Königsblau mit einem fast schwarzen Unterton und vermittelt ein Gefühl von Kraft und Geschwindigkeit. Die Farbpräsenz kann je nach Lichtverhältnissen leicht variieren, wobei sie bei hellem Sonnenlicht kräftiger und gesättigter, in dunkleren Umgebungen gedämpfter erscheint.<br><br>Eine Plakette mit der belgischen Flagge und die Unterschrift von Jacky Ickx auf der B-Säule verweist beim 911 Carrera 4S auf den sechsfachen Le-Mans-Sieger. Das Gemeinschaftsprojekt mit Jacky Ickx ist durch Experten von Style Porsche, der Porsche Exclusive Manufaktur und des belgischen Porsche Importeurs D'Ieteren realisiert worden.","https://player.vimeo.com/video/1098225492?h=ac6df1fb5a","#15151e",[3273],"M5","nachtblaumetallic","/assets/pts/studio_M5.jpg?h=36cf1668d4e297dc3c4345c5b9efe5e0",[2842,3240],"Wahres Blau: nachtblaumetallic ist ein dunkler Blauton, der, wie der Name deutlich macht, mit der Farbe des Nachthimmels in Verbindung steht. Nachtblaumetallic wird manchmal mit dunkelnachtblaumetallic (Farbcode Z5D) verwechselt, ist aber heller und erinnert in seiner Farbbrillianz weniger an Kobalt.<br><br>Die satte Metallic-Lackierung verkörpert eine anspruchsvolle Farbe, die seit Anfang der 1990er Jahre auch als nachtblau Perlcolor auf dem 968, 964 und dem 911 (Typ 993, 996) mit dem Farbcode 39C verfügbar ist. Die Farbe sollte nicht mit dem Porsche Serienfarbton nachtblaumetallic verwechselt werden, der den Farbcode M5F trägt.<br><br>Nachtblaumetallic ist ein tiefes Blau, das je nach Lichtverhältnissen einen leicht violetten oder indigoblauen Unterton hat. Die kräftige blaue Farbe strahlt etwas Geheimnisvolles aus und erzeugt einen dramatischen Look mit viel Eleganz.","https://player.vimeo.com/video/1097499592?h=020cad6c8a","#171d2d",[3281],"L5","meerblau","/assets/pts/studio_L5.jpg?h=f631b669bae2f5cafd35ca91b18e026e",[3240,2852],"Zeitgenössisch: meerblau ist ein dunkles, nicht-metallisches Blau, das an die Farbe des Ozeans in großen Tiefen erinnert. Das gesättigte meerblau strahlt eine kühle, ruhige Wirkung aus und wird mit Gelassenheit sowie Stabilität in Verbindung gesetzt.<br><br>Der anmutende Blauton ist erstmalig Ende der 1980er Jahre auf dem 911 Carrera verfügbar gewesen, es folgen die Modelle 924S, 928 und 944. Die Farbe wurde auch beim SUV-Modell Cayenne im Modelljahr 2003 angeboten.<br><br>Meerblau ist ein elegantes Dunkelblau, das am Tag Blau und in der Nacht oder bei schlechten Lichtverhältnissen fast Schwarz wirkt. Ein besonderer Farbton, der gerne in der Sonne glänzt und eine anspruchsvolle und elegante Anmutung verkörpert.","https://player.vimeo.com/video/1099288720?h=243d5c3f34","#171b29",[3289],"F1","dunkelblaumetallic","/assets/pts/studio_F1.jpg?h=a1d24e873eb2c1675645afe8a4309f4f",[2842,3240],"Autorität auf Rädern: dunkelblaumetallic ist eine kräftige Farbe, die Ruhe verkörpert und für Harmonie steht. Gerade dunkle Blautöne stehen durch die enge Verbindung zu Naturereignissen wie die Tiefe des Meeres oder den Blick in den Himmel für den Traum nach Freiheit. Dunkelblaumetallic repräsentiert Besonnenheit, Objektivität und vermittelt ein Gefühl von Sicherheit. Das ist auch der Grund, warum bestimmte Branchen und Firmen ihre Logos gerne in einem Blauton halten.<br><br>Dunkelblaumetallic ist ein tiefer, glänzender Blauton, der auch als Indigo-, Marine- oder Mitternachtsblau beschrieben werden kann. Der Farblack ist vielseitig und erscheint durch den Metalliceffekt sehr dunkel, aber nicht ganz so dunkel wie Schwarz.","https://player.vimeo.com/video/1097544836?h=72843423a0","#1e2535",[3297],"J3","irisblaumetallic","/assets/pts/studio_J3.jpg?h=af6707a0b068eec214c7916c6cc95625",[2842,3240],"Zarte Verspieltheit: irisblaumetallic ist ein markanter blauer Farbton, der bei Porsche in verschiedenen Farbvarianten ab Mitte der 1980er Jahre gewählt werden konnte. Gestartet auf den Modellen 911 und 928 mit dem Farbcode 33P, konnte „Irisblaumetallic perlcolor“ ab Mitte der 1990er Jahre für den 968 und 911 mit den Farbcodes 39N sowie 39V bestellt werden. Der Metallicfarbton ist von der Farbe der Irisblüte inspiriert, die während der Blütezeit eine üppige tiefblaue Farbpracht entfaltet. <br><br>Irisblaumetallic ist ein mittlerer bis dunkler Blauton mit einem kühlen und beruhigenden Unterton. In ihrer Wirkung wird irisblaumetallic mit Gelassenheit und Ruhe in Verbindung gebracht.","https://player.vimeo.com/video/1097501110?h=70b3d8486d","#1b1e41",[3305],"EA","sanmarinoblaumetallic","/assets/pts/studio_EA.jpg?h=1dcebb961b6adc1e70727e6759a25b8e",[2842,3240],"Atemberaubend: sanmarinoblaumetallic ist ein moderner Blaufarbton, der den Namen der bergigen Enklave im Norden Mittelitaliens trägt. San Marino zählt zu den ältesten Republiken der Welt und ist eine mittelalterliche Altstadt, die von einer Mauer umgeben und für ihre schmalen, kopfsteingepflasterten Straßen bekannt ist. Der Blick von dort auf die Adria hüllt den Horizont in ein stilvolles Blau. <br><br> Sanmarinoblaumetallic ist ein tiefer, satter Blauton, der gerne bei Hochleistungsfahrzeugen verwendet wird. Die Farbe wurde auf individuellen Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und ist heute als Farbe nach Wahl Option bestellbar.<br><br>Sanmarinoblaumetallic ist ein metallisches Blau mit einem leicht violetten Unterton. Das klare und satte Blau hat ein perlmuttartiges Metallfinish, welches das Licht tiefgreifend einfängt. Beim Anblick der Farbe entstehen Assoziationen zu Kraft, Leistung und Luxus. In der Kombination mit anderen kräftigen Farben wie Rot oder Gelb kann ein ins Auge fallender Kontrast erzielt werden.","https://player.vimeo.com/video/1097755067?h=762a08096c","#181956",[3313],"X7","baliblau","/assets/pts/studio_X7.jpg?h=6668924d821428e7e20672aa061aff39",[3240,2852],"Historische Verbindung: die Farbe baliblau hat bei Porsche eine lange Tradition. Sie gilt in den 1960er Jahren als ein beliebter Farbton für die 356er Modelle und wird später bei der Modelleinführung des 911 als eine von vier Sonderlackierungen angeboten. Damit reiht sich die Farbe in die bunten Erinnerungen an die klassischen Porsche Fahrzeuge vergangener Zeiten ein.<br><br>Baliblau kann als dunkles Blau mit einem leichten Hauch von Aubergine beschrieben werden. Während die Farbe im Schatten edel und eher zurückhaltend dunkel wirkt, entfaltet sie im Sonnenlicht eine intensive und tiefe Strahlkraft, die alle Blicke auf sich zieht.","https://player.vimeo.com/video/1097444967?h=a0adbbc530","#172033",[3321],"A8","albertblau","/assets/pts/studio_A8.jpg?h=8591a83bfea0aafdd23bc95bd8c79515",[3240,2852],"Historische Anziehungskraft: albertblau ist eine klassische Porsche Farbe, die aufgrund ihrer blauen Eleganz sowie des historischen Bezugs zur Marke Porsche bis heute bei Sammlern geschätzt wird. Der dunkle Blauton wird seit den 1970er Jahren angeboten, sowohl die Farbcodes als auch die Verfügbarkeit auf den jeweiligen Modellen ändern sich mit den Jahren.<br><br>1970 ist albertblau unter 1810 und 1818 für den 911 Targa sowie das Coupe erhältlich. Es folgen mit dem Farbcode 325 der 911 im Jahr 1972 und mit Farbcode 387 der 928 im Jahr 1978.<br><br>Albertblau ist ein satter, nichtmetallischer Blauton. Die Farbnuance liegt zwischen einem Marine- und Mittelblau.","https://player.vimeo.com/video/1097524926?h=2c9e0eacad","#12203b",[3329],"B3","aquablaumetallic","/assets/pts/studio_B3.jpg?h=9d57094dac5949bb574d05948a4949ae",[2842,3240],"Auffällig erfrischend: aquablaumetallic ist ein lebendiger und historischer Porsche Farbton mit metallischem Glanz, der an den natürlichen Edelstein Aquamarin erinnert. Der Edelstein ist für seine hellen und blaugrünen Farbtöne bekannt und spiegelt die Weite der Ozeane wider.<br><br>Bei Porsche haben Metallic-Blaufarbtöne Tradition – dazu zählen das historische „Aquamarinmetallic“ der 356-Ära oder „Aquamarinblaumetallic“ ab 2009. „Aqua Blau Metallic“ ist ab den frühen 2000er Jahren unter dem heutigen Farbcode für die Modelle 911 (997), 718 Boxster (986, 987) und den Panamera verfügbar.<br><br>Der Farbton aquablaumetallic kann von einem hellen Blaugrün bis zu einem tieferen Türkis reichen. Die metallische Oberfläche erzeugt einen subtilen Schimmereffekt, die Entspannung und Ruhe assoziieren. Der Blauton ist eine seltene Fahrzeugfarbe, die für ein kühnes und modernes Aussehen steht. Als dynamische Farbe garantiert sie einen frischen Look mit Vielseitigkeit.<br><br>Im Rahmen des Jubiläumsjahrs „50 Jahre 911“ würdigt Porsche seine 5 Millionen Fans bei Facebook mit einem echten Unikat: Der 911 Carrera 4S „5M Porsche Fans“ entsteht auf Basis einer bei Facebook abgestimmten Wunschkonfiguration in der Farbe aquablaumetallic und wird im Jahr 2013 zu einem außergewöhnlichen Highlight-Projekt.","https://player.vimeo.com/video/1099294277?h=94c93c9b2d","#021546",[3337],"E2","944cobaltblaumetallic","/assets/pts/studio_E2.jpg?h=594133751c0d3fa94c587d8478a640d4",[2842,3240],"Dramatische Intensität: 944cobaltblaumetallic ist die intensive Variante eines hellen, metallischen Blautons, das durch seinen glänzenden Schimmer eine elektrisierende Leuchtkraft entwickelt. Die Farbe ist schon seit den 1990er Jahren ein äußerst beliebter Außenlack.<br><br>Durch den leicht violetten Unterton wirkt 944cobaltblaumetallic stilvoll und zugleich auffallend lebendig. Der Farbton ist vermutlich nach dem Element Kobalt benannt, das zur Herstellung des Farbstoffs verwendet wird, der diesen unverwechselbaren Blaufarbton erzeugt.","https://player.vimeo.com/video/1097438078?h=948a56c5b0","#2c3c6c",[3345],"UH","jebsenblau","/assets/pts/studio_UH.jpg?h=50241a188cf8c5583a495e97dccc8d6a",[3240,2852],"<p>Jebsenblau ist ein tiefdunkler Blauton mit einem feinen, leicht violetten Unterton. </p><p><br></p><p>Entwickelt wurde er im Jahr 2025 anlässlich des 70‑jährigen Jubiläums des chinesischen Porsche Importeurs Jebsen Group. Inspiriert von der Farbe des Firmenlogos der Jebsen Group, wurde jebsenblau über den Farbe nach Wahl Plus Prozess nachgestellt und exklusiv auf einem einmaligen Sonderwunsch 911 Targa 4 GTS umgesetzt.</p><p><br></p><p>Jebsenblau wirkt kraftvoll und intensiv, bleibt jedoch durch seine dunkle Grundnuance äußerst elegant und zurückhaltend. In hellen wie in dunklen Umgebungen zeigt der Farbton eine klare, hochwertige Präsenz – kontrastreich, tief und edel. Er ist ideal für Kunden, die eine ausdrucksstarke, aber dennoch unaufdringliche Farbwahl bevorzugen.</p>","https://player.vimeo.com/video/1163940132?h=ec77b39045","#2c325c",[3353],"CV","manausblau","/assets/pts/studio_CV.jpg?h=6295ec417ec5db3ff7c8213bed714ce2",[3240,2852],"Exotische Dynamik: manausblau ist ein tiefer Blauton, der nach der brasilianischen Stadt Manaus benannt ist, die am Zusammenfluss des Rio Negro und des Amazonas liegt. In der Natur kommt der Farbton unter anderem im leuchtenden Gefieder tropischer Vögel vor. Die kräftige Wirkung von manausblau ruft die Assoziation zu Abenteuer und der Sehnsucht an exotische Ziele zu reisen hervor.<br><br>Manausblau ist auf individuellen Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt worden und ist heute als Farbe nach Wahl Option verfügbar.<br><br>Die Farbe ist ein sehr tiefes, reiches Blau, das in seiner Wirkung verstärkt wird, wenn es mit einem hellen Ton wie kreide in einen Kontext gestellt wird.<br><br>Als kräftige und auffällige Farbe deckt manausblau den Bereich der mittleren bis dunklen Blautöne ab. Mit der aufmerksamkeitsstarken und verspielten Farbe entsteht ein intensives Statement nach Lebendigkeit.","https://player.vimeo.com/video/1097752497?h=9ae7971158","#0d2a49",[3361],"KJ","yachtingblaumetallic","/assets/pts/studio_KJ.jpg?h=92f93d1202a25285a11873d270134a4d",[2842,3240],"Erfrischende Brise: yachtingblaumetallic ist ein dezenter metallischer Blauton, der von den vielen unterschiedlichen Blautönen inspiriert ist, die in der Welt der Jachten und des Segelns gegenwärtig sind. Die Farbe wird häufig für Bootsrümpfe und Segelabdeckungen verwendet.<br><br>Der Farbton ist 2010 als eine der zehn Serienfarben bei der ersten Generation des Porsche Panamera (Typ 970) eingeführt worden.<br><br>Yachtingblaumetallic ist ein satter, tiefer Blauton, der von einem leicht grünlichen Blau bis hin zu einem dunkleren Marineblau variieren kann. Der Metallicschimmer verleiht dem Farbton eine klassische Eleganz. Yachtingblaumetallic hat einen leicht kühlen Unterton, der ein erfrischendes Gefühl verleiht.<br><br>Die Farbe wird oft als eine Mischung aus Marineblau und Königsblau mit einem Hauch von Grau beschrieben, was die Karosserieform auf besondere Weise betont.","https://player.vimeo.com/video/1097543437?h=54fbb17665","#3b4152",[3369],"NO","azurblau356","/assets/pts/studio_NO.jpg?h=719c2c28995810964068ab6951bfb518",[3240,2852],"Tief verwurzelte Freundschaft: azurblau356 ist die Neuinterpretation des Farbtons „Azurblau“, den Porsche für den 356 America Roadster Anfang der 1950er Jahre entwickelt hat.<br><br>Der Farbton azurblau356 ist im Farbe nach Wahl Plus Prozess speziell für die 911 Carrera GTS Cabriolet America Edition im Jahr 2022 neuaufgelegt worden, um gleich zwei Anlässe würdig zu feiern: das 70-jährige Jubiläum des Porsche 356 America Roadsters und das 30-jährige Jubiläum des 964 America Roadsters. <br><br>Die Außenfarbe ist eine moderne Interpretation des historischen azurblau, die in Zusammenarbeit mit Experten von Style Porsche, der Porsche Exclusive Manufaktur sowie Vertretern von Porsche Cars North America, Porsche Canada Limited und Impulsen aus dem historischen Archiv entstanden ist.<br><br>Azurblau356 ist ein sattes Mittelblau mit einem leicht grünlichen Unterton und erinnert an einen tiefblauen Himmel an einem klaren Tag. Die anregende Farbe strahlt Gelassenheit aus und vermittelt ein Gefühl von Entspannung und Offenheit.","https://player.vimeo.com/video/1099635365?h=9f6ba120ac","#192b42",[3377],"G5","golfblau","/assets/pts/studio_G5.jpg?h=1c3026c03b0180b4f922dfef678b2b7b",[3240,2852],"Ein halbes Jahrhundert Geschichte: golfblau ist ein echter Klassiker unter den Porsche Farben. Die historische Porsche Sonderfarbe ist auch eine historische Volkswagen Sonderfarbe und schon ab Mitte der 1960er Jahre für den 911 und den 912 (F-Modell) im Angebot gewesen.<br><br>Golfblau ist ein nicht-metallisches Mittelblau, aber dunkler als die spätere bekannte Farbe gulfblau und daher auch nicht mit ihr zu verwechseln. Es wird vermutet, dass sich der Farbname sowie die Farbe selbst vom warmen Meeresstrom aus dem Golf von Mexiko ableiten.<br><br>Beim Blick auf das Porsche 911 2.0 Coupe (Ur-911) aus dem Jahr 1966 in golfblau beschäftigen sich die Gedanken unweigerlich mit der Dimension und Weite der Meere.","https://player.vimeo.com/video/1099300542?h=cf44b5fab5","#173961",[3385],"N3","nogaroblaumetallic","/assets/pts/studio_N3.jpg?h=2bef24ec662d33d50cb46f5f6f2099b8",[2842,3240],"Aus der Masse herausstechen: nogaroblaumetallic ist ein heller und leuchtender Blauton, der durch seinen sportlich-aggressiven Look besonders auf Hochleistungsfahrzeugen zur Geltung kommt. Der Farbname leitet sich nach dem Ort einer bekannten Motorsport-Rennstrecke im Südwesten Frankreichs ab – dem Circuit Paul Armagnac, der auch als Circuit de Nogaro bekannt ist.<br><br>Der Farbton selbst stammt von Audi und ist 1994 als erstes bei der Markteinführung beim damals schnellsten Kombi der Welt, dem Audi RS 2 Avant, verwendet worden. Das Fahrzeug bildet den Start der starken RS-Familie, hat seine Wurzeln aber in Zuffenhausen – der Audi RS 2 Avant ist als Kooperationsprojekt zwischen Audi und Porsche entstanden.<br><br>Nogaroblaumetallic ist eine auffällige Farbe, die einen leicht violetten Unterton aufweist und ein unverkennbares Metallic-Finish besitzt, das nur unter direktem Lichteinfall erkennbar ist. Der Blauton ist dynamisch sowie aufregend und vermittelt ein Gefühl von Kraft und Geschwindigkeit.","https://player.vimeo.com/video/1098216934?h=9f43178b13","#163174",[3393],"E1","clubblau","/assets/pts/studio_E1.jpg?h=f44c8a8ec7cddd61ea4486a782ac8f23",[3240,2852],"Exklusive Spannung: mit dem auffälligen Farbton clubblau hat Porsche das 60-jährige Jubiläum des Porsche Club of America (PCA) im Jahr 2015 gefeiert. Zu diesem Anlass hat der Stuttgarter Sportwagenhersteller das 911 GTS Club Coupe aufgelegt – exklusiv für die Kunden in Nordamerika und exklusiv in der Farbe clubblau.<br><br>Der energiegeladene Blauton ist abgeleitet vom PCA-Logo sowie eine Neuinterpretation der Logo-Originalfarbe „acidblau“. Er wurde im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und ist heute als Farbe nach Wahl Option verfügbar.<br><br>Clubblau ist eine Lackfarbe, die charakteristisch für Porsche steht. Als kräftige und lebendige Farbe vermittelt clubblau ein Gefühl von Energie gepaart mit Aufregung. Das helle, lebendige Aussehen des Blaufarbtons wird als „elektrisch“ oder „neonfarben“ wahrgenommen, clubblau erzeugt dadurch Sportlichkeit und einen eigenen Ausdruck von Athletik. Die Farbe steht für Persönlichkeit und ein modernes Flair.<br><br>Von dem Sondermodell sind nur 60 Exemplare für den amerikanischen Markt entstanden, alle 911 Club Coupes sind bis heute begehrte Sammlerstücke.","https://player.vimeo.com/video/1097752886?h=cf6767f869","#0e3872",[3401],"O3","osloblau","/assets/pts/studio_O3.jpg?h=8eb11f4e39d5d7c1fa172d97c95faa0d",[3240,2852],"Das Original: die Farbe osloblau vereint historischen Wert mit moderner Beliebtheit. Der dunkle, nicht-metallische Farbton ist ein Blau, das Anfang der 1960er Jahre auf dem 356 B verfügbar war und vermutlich in Anlehnung an die norwegische Hauptstadt Oslo entstanden ist. Die skandinavischen Länder zeichnen sich durch eine einzigartige Kultur, beeindruckende Naturlandschaften und ein Zusammengehörigkeitsgefühl aus.<br><br>Osloblau ist eine weiche und dezente Farbe mit einem leicht gräulichen oder grünlichen Unterton, der ihr ein ruhiges Aussehen verleiht. Der Farbton wird verwendet, um eine friedliche und entspannende Atmosphäre zu schaffen. Die schlichte Eleganz von osloblau ist oft auf GT-Modellen zu finden, um das anspruchsvoll-beruhigende Auftreten stilvoll zu betonen.<br><br>Anlässlich des 20. Jahrestags zum Verkauf von Porsche Fahrzeugen in China ist die Sonderedition 911 Turbo S 20 Years Porsche China (992) in 5 Farben aufgelegt worden – eine davon ist osloblau.","https://player.vimeo.com/video/1099310137?h=235b853e51","#124661",[3409],"W3","nashyblue","/assets/pts/studio_W3.jpg?h=b51087d6f787a921e7b86d5f8d12a342",[3240,2852],"Inspirierend neu: Nashyblue ist ein mittleres Blau, das aus der exklusiven Zusammenarbeit des Sportwagenherstellers mit dem amerikanischen Designer und Influencer Sean Wotherspoon entstanden ist: Ein Art Car bestehend aus 4 Farben: Nashyblue, seanpeach, lorettapurple und ashleygreen.<br><br>Die Herkunft des Farbnamens nashyblue hat dabei einen ganz persönlichen Hintergrund: so hat der Designer die neu kreierte Farbe nach seinem Sohn Nash benannt.<br><br>Im Jahr 2024 wird die moderne Farbe nashyblue in das Farbe nach Wahl Produktprogramm aufgenommen und kann von allen Porsche Liebhabern bestellt werden.","https://player.vimeo.com/video/1097449491?h=adb2218cc3","#486279",[3416],"C6","blautürkis","/assets/pts/studio_C6.jpg?h=1769119442883b0d981d5cff59e2ae9d",[3240,2852],"Tropische Frische: der Farbton blautürkis hat eine besondere Ausstrahlung, die an das Wasser einer tropischen Insel erinnert. Der ansprechende Farbton blautürkis vermittelt ein Gefühl von frischer Energie und überzeugt durch eine leichte wie luftige Raffinesse.<br><br>Die Farbe ist Ende der 1990er Jahre für wenige Jahre im Farbprogramm bei Porsche verfügbar und heute als Farbe nach Wahl Option bestellbar.<br><br>Blautürkis setzt einen erfrischenden Akzent und vermittelt das entspannende Gefühl, auf Meerwasser zu blicken. Optisch ähnelt blautürkis den Farben rivierablau und mexikoblau, ist jedoch ein wenig dunkler und hat einen leicht grünen Unterton.","#0c527d",[3423],"L2","maritimblau","/assets/pts/studio_L2.jpg?h=5ce16dd97f471c53203a1f2298d33d25",[3240,2852],"Hochwertige blaue Tradition: maritimblau ist ein kräftiger, nicht-metallischer Porsche Blauton, der sich vom lateinischen Wort „maritimus“ ableitet und „zum Meer gehörend“ bedeutet.<br><br>Der Farbton ist Anfang der 1990er Jahre für den 911, 944 und 968 verfügbar und heute fester Bestandteil des Farbe nach Wahl Produktprogramms.<br><br>Maritimblau ist ein mittelblauer Farbton mit einem leicht kühlen Unterton, der durch die Assoziation mit dem Meer ein frisches und erfrischendes Gefühl verleiht. Der Farbton ist inspiriert vom maritimen Leben und verkörpert ein kühnes wie auffälliges Erscheinungsbild, was es zu einer beliebten Wahl für hochwertige Fahrzeuge und Luxusmarken macht.","#304187",[3430],"DB","pfeilblau","/assets/pts/studio_DB.jpg?h=cc326f7a3b51c213212cc2e8d4a6ed6c",[3240,2852],"Agiler Auftritt: pfeilblau ist ein lebendiger Blauton, der durch seine Intensität als gewagt gilt und bei Porsche Sammlern inzwischen sehr geschätzt wird. Seit 1976 war der Farbton unter dem Farbcode 305 für die Modellreihen 911, 912 und 928 verfügbar - damals unter dem Namen Arrowblau. Die Farbe ist 1982 aus dem Programm genommen worden und heute als Farbe nach Wahl Option verfügbar.<br><br>Pfeilblau ist ein dynamischer Blauton, der ein erfrischendes Aussehen verleiht. Fahrzeuge in pfeilblau sind als Mittel- bis Dunkelblau mit einem leicht kühlen Unterton einzustufen. Die Farbe strahlt Sportlichkeit aus und wird mit Geschwindigkeit, Agilität und Präzision assoziiert.","#0e4889",[3437],"KG","voodooblau","/assets/pts/studio_KG.jpg?h=a1b00218fcac7533fa59a025ec563d68",[3240,2852],"In den Bann gezogen: voodooblau ist ein kräftiger, intensiver Blauton und eine moderne Interpretation der klassischen Porsche Farben mexikoblau sowie pfeilblau. Die Farbe ist ein heller, elektrisierender Blaufarbton, der intensiv in seiner Strahlkraft ist. Der Name „voodoo“ bezieht sich auf die mystische und bezaubernde Qualität der Farbe, die ein Gefühl von Energie und Abenteuer ausstrahlt.<br><br>Voodooblau ist ein gesättigtes Blau mit einem Hauch von Grün, das der Farbe des karibischen Meeres ähnelt. Der Farbton ist für sein kühnes und lebhaftes Erscheinungsbild bekannt und eine beliebte Wahl für sportliche und abenteuerliche Fahrzeuge wie Geländewagen und Rallyeautos. Es handelt sich um eine auffällige Farbe, die die Aufmerksamkeit auf sich zieht und im Straßenverkehr auffällt.","#0e4d8f",[3445],"WP","sharkblue","/assets/pts/studio_WP.jpg?h=8165e73f870ac9d3a2e317c1b2143fe8",[3240,2852],"<p>Sharkblue ist ein intensiver, moderner und selbstbewusst leuchtender Blauton, der im Jahr 2021 erstmals vorgestellt wurde. Sein Debüt feierte er als markante Kommunikationsfarbe des 911 GT3 (992).</p><p><br></p><p>Der satte, tiefblaue Farbton wirkt energiegeladen und betont die sportliche Form des Fahrzeugs. Im Sonnenlicht zeigt sharkblue eine brillante Leuchtkraft, die ein Gefühl von Energie, Geschwindigkeit und Präsenz vermittelt. In Schattenbereichen wirkt der Ton dagegen etwas tiefer und ruhiger, bleibt aber durch seine hohe Pigmentdichte stets kraftvoll und definiert.</p><p><br></p><p>Sharkblue ist damit ein Farbton, der Performance bewusst nach außen trägt – ideal für Kunden, die nicht nur ein sportliches Fahrzeug fahren, sondern diese Sportlichkeit auch farblich sichtbar machen möchten. </p>","https://player.vimeo.com/video/1163939875?h=b205c8c59d","#0c5aa6",[3453],"UG","daniblau","/assets/pts/studio_UG.jpg?h=87d87411e6a9715567baf69888995076",[3240,2852],"<p>Wenn die Traumfarbe Realität wird: daniblau ist ein individuell entwickelter Blauton, der 2024 im Rahmen des Farbe nach Wahl Plus Programms entstanden ist. Der exklusive Farbton wurde eigens für den Porsche Enthusiasten und Sonderwunsch Kunden Jorge Carnicero entwickelt, der für seinen 911 S/T einen unverwechselbaren, modernen, aber nicht zu lauten Blauton wünschte.</p><p><br></p><p>Im Rahmen des Farbentwicklungsprozesses wurden mehrere unterschiedliche Lackmuster mit Blautönen für Jorge Carnicero angefertigt, die zur finalen Farbentscheidung beitragen sollten. Das historische Emailblau, ein klassischer Blauton, den das Porsche 901 Sportcoupé von 1964 trug, galt schnell als Favorit und Inspirationsquelle und wurde weiterentwickelt und neu interpretiert.</p><p><br></p><p>Das Ergebnis: daniblau. Ein zeitgemäß wirkendes, klares Blau, das leicht dunkler, intensiver und farbiger ist als Emailblau und den modernen, sportlich‑puristischen Charakter eines Sportwagens perfekt unterstreicht.</p><p><br></p><p>Carnicero war so begeistert, dass er die neue Farbe daniblau nach dem Spitznamen der Porsche Color &amp; Trim Designerin Daniela Milošević benannte, die den Farbprozess maßgeblich begleitete.</p>","https://player.vimeo.com/video/1163940114?h=b127c29ec7","#275c8c",[3461],"NT","südseeblaumetallic","/assets/pts/studio_NT.jpg?h=3401dc6206612b753d8776a814ac6c38",[2842,3240],"<p>Südseeblaumetallic ist ein heller und leuchtender Blau-Metallic-Ton, der vermutlich nach der Farbe der Südsee benannt ist, die für ihr kristallklares blaues Wasser bekannt ist. Der leicht silberne und türkisfarbene Unterton verleiht der lebendigen Farbe dabei ein tropisches und exotisches Gefühl.</p><p><br></p><p>Die Lackfarbe ist ursprünglich eine Farboption eines deutschen Automobilherstellers. Sie lässt sich gut mit einer Vielzahl anderer Farben kombinieren, darunter tiefere Blautöne, Beige oder Erdtöne.</p>","https://player.vimeo.com/video/1097449831?h=94d18feb96","#3277a8",[3469],"L9","mexikoblau","/assets/pts/studio_L9.jpg?h=a47a6175ad40451ec50d9ec03c0ed756",[3240,2852],"Tropische Leichtigkeit: mexikoblau ist ein prägnanter heller Porsche Blauton, der von den kräftigen Farben der amerikanischen Muscle Cars der 1960er und 1970er Jahre inspiriert ist. Der intensive Blauton ähnelt der Farbe des Karibischen Meeres sowie einer hellblauen Agave und kann im Farbspektrum zwischen Himmelblau und Türkis eingeordnet werden. Mexikoblau steht für Lebendigkeit und ist ein hell- bis mittelblau, das ab 1974 mit einigen folgenden Unterbrechungen unter dem Farbcode 336 für den 911 bestellt werden konnte.<br><br>Der nicht-metallische Farbton wirkt zeitlos, weil er perfekt zu jedem Sportwagen passt. Mexikoblau ist ein lebendiger und fröhlicher Blauton. Es hat einen leicht grünlichen Unterton, der ihm ein einzigartiges exotisches Aussehen verleiht.<br><br>Mexikoblau hat in den USA viele Anhänger und ein bekannter Porsche Sammler ist dazugekommen – Schauspieler und Komiker Jerry Seinfeld hat den letzten luftgekühlten 911 Carrera 4 S (993) bestellt und auch erhalten, der am 31.03.1998 im Werk Zuffenhausen in der Farbe mexikoblau gebaut wurde.","https://player.vimeo.com/video/1097526810?h=59eb340276","#0e70a9",[3477],"DV","rivierablau","/assets/pts/studio_DV.jpg?h=58605bdd27acb5fc1fea566290c29589",[3240,2852],"<p>Charismatisch: rivierablau ist ein lebendiger hellblauer Farbton, der vom strahlend blauen Wasser an der italienischen wie französischen Rivieraküste inspiriert ist. Rivierablau verleiht ein kühles, erfrischendes Aussehen und vermittelt ein aufregendes Gefühl von Geschwindigkeit.</p><p><br></p><p>Anfang der 1990er Jahre ist rivierablau auf dem 911 (993), dem 928 und 968 verfügbar. Sie ist eine der Markteinführungsfarben des 911 (993), auch viele Pressefahrzeuge sind in dieser Farbe konfiguriert und zahlreich in den Automagazinen dieser Zeit vorzufinden.</p><p><br></p><p>Rivierablau ist ein klares, helles Blau mit einem leicht grünlichen Unterton. Das leicht metallische oder perlmuttartige Finish verleiht einen subtilen Schimmer, der spielerisch das Licht einfängt. Rivierablau ist eine beliebte Wahl für Hochleistungssportwagen und wird hier mit anderen hellen Farben wie Rot oder Gelb kombiniert, um einen auffälligen Effekt zu erzielen.</p>","https://player.vimeo.com/video/1097500354?h=738f8814c4","#0f80c0",[3485],"UP","miamiblau","/assets/pts/studio_UP.jpg?h=3733271e422e731186e8e6d48ab77b77",[3240,2852],"<p>Charismatisch und modern: miamiblau ist ein kühn wirkender und hell leuchtender Blaufarbton, der erstmalig 2017 auf dem 911 angeboten wurde. Der hellblaue Ton erinnert an das glitzernde Wasser des Ozeans und den klaren Himmel an einem sonnigen Tag – wie er auch an der Ostküste der USA zu beobachten ist. 2018 ist miamiblau auf den 718 Modellen Boxster/Cayman und ein Jahr später auf dem Macan verfügbar gewesen.</p><p><br></p><p>Bei miamiblau handelt es sich um einen kräftigen hellblauen Farbton mit einem leichten Grünstich, der ein kühles, erfrischendes Gefühl vermittelt. Miamiblau wird oft mit tropischen Umgebungen assoziiert, da es eine beliebte Farbe für Strand- und Resortkleidung ist. Miamiblau ist lebendig und verspielt, es verleiht eine energiegeladene Ausstrahlung und ruft Glück, Entspannung und Freude hervor.</p>","https://player.vimeo.com/video/1163939843?h=cb9f2a653b","#0c7a96",[3493],"J1","ipanemablaumetallic","/assets/pts/studio_J1.jpg?h=8c59c0413d6c3de30561bdfdc11383cf",[2842,3240],"Brasilianische Vibes: ipanemablaumetallic ist ein türkisfarbener Metallicfarbton, der von der farbenfrohen und lebhaften Atmosphäre des brasilianischen Viertels Ipanema in Rio de Janeiro inspiriert ist – dazu zählt auch der gleichnamige, rund zwei Kilometer lange Sandstrand.<br><br>Das attraktive Blau spiegelt das einmalige südamerikanische Lebensgefühl wider und ist als Sonderfarbe nur für das Modelljahr 2012 des 911 (997.2) angeboten worden.<br><br>Ipanemablaumetallic wird oft als tropische oder ozeanische Farbe beschrieben. Grundsätzlich ist ipanemablaumetallic ein vielseitiger Farbton, der als Akzentfarbe eingesetzt werden kann, um ein Gefühl von Energie und Spannung zu verleihen.<br><br>Der starke Metalliceffekt von ipanemablaumetallic sorgt für einen fröhlichen und extrovertierten Auftritt.","https://player.vimeo.com/video/1097440574?h=4a83a55916","#478797",[3501],"A5","aetnablau","/assets/pts/studio_A5.jpg?h=4e5d7aae5a980953c61533d5f5b974a7",[3240,2852],"<p>Zeitlos, klassisch und elegant: aetnablau ist ein historischer Farbton mit einem klaren Bezug zu den Porsche Anfangsjahren. Der bekannte Blauton ist Anfang der 1960er Jahre auf dem legendären Porsche 356 B erhältlich und hier auch als „Ätnablau“ oder „Etnablue“ bezeichnet worden. Der damalige Farbcode lautet R740 oder auch 6003.</p><p><br></p><p>Im Jahr 2009 ist aetnablau auf dem 911 (997) unter dem heutigen Farbcode zurückgekehrt.</p><p><br></p><p>Der Blaufarbton wirkt subtil und besticht durch einen leichten Hauch von Grau sowie pastellfarbenen Untertönen. Aetnablau verleiht einem Fahrzeug ein zeitloses und klassisches Design, die Farbkomposition hinterlässt ein beruhigendes Gefühl von Gelassenheit und Eleganz.</p><p><br></p><p>Weitere Popularität erlangt aetnablau als Exterieurfarbe der 911 Targa 4S Exclusive Design Edition (991.2) aus dem Jahr 2016. Die Sonderedition ist detailverliebt veredelt und nur für einen begrenzten Zeitraum verfügbar gewesen.</p>","https://player.vimeo.com/video/1097833675?h=05481c14f3","#475b6d",[3509],"L6","meissenblau","/assets/pts/studio_L6.jpg?h=2f7e1486d1d75f55ffa040fcd665d72d",[3240,2852],"Zarte Historie: meissenblau ist eine historische Porsche Farbe, die als Standardton auf dem 356 A Ende der 1950er Jahre angeboten wurde. Die Farbcodes des klassischen Pastelltons sind 5703 und Reutter 703. Der spezielle Blauton ist nach der deutschen Stadt Meißen benannt, die für das dort hergestellte feine Porzellan berühmt ist. Die Porzellanfabrik Meissen hat den Farbton meissenblau erstmalig im 18. Jahrhundert entwickelt, welcher besonders bei Kaffeeporzellan beliebt ist.<br><br>Meissenblau wird oft auch als „puderblau“ oder „delftblau“ bezeichnet und ist etwas grauer als gulfblau. Der helle Blaufarbton ist ein weicher, gedämpfter Farbton mit einem leichten grauen Unterton, der zarte wie ruhige Eigenschaften transportiert. Meissenblau ist nicht so lebendig wie andere Blautöne, transportiert aber ein sehnsüchtiges Vintage-Gefühl und vermittelt eine bestimmte Form der Zurückhaltung. Als heller Blaufarbton harmoniert meissenblau mit Rottönen oder neutralen Farben wie Weiß, Creme oder Beige.","https://player.vimeo.com/video/1098224381?h=0796bd44b4","#7f9ba8",[3517],"I1","gulfblau","/assets/pts/studio_I1.jpg?h=c0a567846754bcfeb83c241db0df7cd0",[3240,2852],"Kultstatus: wenn eine Porsche Farbe Sinnbild für die sportlichen Attribute von Porsche steht, dann ist es die Verbindung von gulfblau zur Rennwagen-Lackierung aus den 1970er Jahren. Der spezifische Blauton geht auf die hellblau-orangefarbene Gulf Oil-Lackierung des Porsche 917 zurück, die der britische Motorsportingenieur John Wyer im Steve McQueen-Film „Le Mans“ ikonisch in Szene gesetzt hat. Die Namensgebung des Farblacks geht auf den Firmennamen „Gulf Oil“ selbst zurück, die als Sponsor für das Rennteam John Wyer Automotive aufgetreten sind.<br><br>Gulfblau ist ein helles Pastellblau, das durch seine leichte und luftige Anmutung auch als „Baby Blau“ bezeichnet wird. Mit orangenen Akzenten oder Streifen kombiniert, schafft gulfblau einen auffälligen visuellen Kontrast, der ein Gefühl von Geschwindigkeit und Bewegung vermittelt.<br><br>Gulfblau ist Mitte der 1970er Jahre nur für sehr kurze Zeit offiziell erhältlich gewesen und erfreut sich seit der Aufnahme in das Farbe nach Wahl Programm großer Popularität.<br><br>Neben der Assoziation mit der Rennlackierung von Gulf Oil, ist ein weiteres bekanntes Beispiel für einen gulfblauen Porsche der IROC 911 Carrera RSR #9 von 1974, der vom legendären Rennfahrer Bobby Allison gefahren wurde.","https://player.vimeo.com/video/1097525897?h=a0ca403baf","#84acc7",[3525],"O2","914olympblue","/assets/pts/studio_O2.jpg?h=52ba97c975439a7431b342e0b2aeb13c",[3240,2852],"Geschichte in Farbe: nahezu alle Außenfarben der 914-Modellreihe haben eines gemeinsam – sie sind auch auf den Fahrzeugen aus dem Mutterkonzern Volkswagen zu finden und umgekehrt. 914olympblue ist ein pastellfarbenes Blau, das dem bekannten gulfblau ähnelt und Anfang der 1970er Jahre unter der Farbbezeichnung „olympiablau“ bekannt wurde.<br><br>Die historische Farbe ist ursprünglich für den Volkswagen Käfer entwickelt worden und dann auch für das von Volkswagen gebaute Porsche Modell 914 erhältlich gewesen.<br><br>Als kräftiger und lebendiger Blauton erinnert 914olympblue an sportliche Tugenden und vermittelt ein Gefühl von Stärke, Entschlossenheit sowie Leistungsorientierung. Die kühne, energiegeladene Farbe erzielt durch ihre Deckkraft ein starkes und selbstbewusstes Aussehen.","https://player.vimeo.com/video/1098222208?h=fad958ca26","#5aacc8",[3534],"JK","superiorrotmetallic","/assets/pts/studio_JK.jpg?h=cbe6005ac8af894bb05d4ca53ea11a91",[2842,3533],"Wohltuende Gemütlichkeit: superiorrotmetallic ist ein dunkles, metallisches Burgunderrot, das an die reichen Farbtöne der Burgundertrauben erinnert und der Erde, in der sie wachsen. Das warme und bräunliche Dunkelrot ist eine besondere Farbwahl bei Kunden.<br><br>Der Farbton ist auf Wunsch eines Kunden im Rahmen des Farbe nach Wahl Plus Prozesses nachgestellt und später ins Farbe nach Wahl Programm übernommen worden.<br><br>Superiorrotmetallic ist ein tiefdunkles und warmes Burgunderrot, das durch das metallische Finish einen eigenen Glanz erhält. Der Farbton verändert je nach Lichtverhältnissen sein Erscheinungsbild. Während er im Schatten fast schwarz wirkt, entfaltet sich die Farbe bei Sonnenlicht aufregend schön in Richtung Burgunderrot-Lila. Superiorrotmetallic ist eine beruhigend wirkende Farbe, die eine zeitlose Eleganz und eine klassische Note ausstrahlt.","https://player.vimeo.com/video/1097751510?h=d84fe7ba2d","TAG9","#231c21",[3542],"H9","GTS-rot","/assets/pts/studio_H9.jpg?h=397991f292de12ba1ac7bccfcd353146",[2852,3533],"Exklusive Sportlichkeit: die Bezeichnung GTS steht für Gran Turismo Sport und wird für die jeweils sportlichste Modellvariante pro Baureihe verwendet. Auf klassische und dennoch zeitgemäße Art verbindet die Marke Porsche durch GTS-rot ihren Ruf für präzise Technik und aufregende Fahrerlebnisse.<br><br>Die erste spezifische GTS-Farbe wurde in den 2000er Jahren für den Cayenne und dessen GTS-Derivat entwickelt.<br><br>GTS-rot als heller bis mittlerer Rotton erzeugt auf einem Fahrzeug Dynamik sowie Dramatik. Die auffällige Farbe ist satt und tief, vermittelt dadurch ein energiegeladenes Gefühl von Kraft sowie Geschwindigkeit. Im Vergleich zu indischrot ist GTS-rot ein eher „blauerer“ Rot-Farbton.<br><br>Mit GTS-rot greift Porsche die Herkunft und Tradition als Sportwagenhersteller im Motorsport auf. In den 1960er Jahren hat Porsche erstmalig den 904 Carrera GTS vorgestellt. Der Rennwagen erzielt einen Gesamtsieg bei der Targa Florio, Klassensiege bei den 24-Stunden von Le Mans sowie den 12-Stunden von Sebring und ist auch mit Straßenzulassung gebaut worden. So steht Grand Tourismo Sport für Langstreckentauglichkeit und zugleich dem Porsche-typischen Komfort.","https://player.vimeo.com/video/1097536621?h=bc54a3db67","#5f0d13",[3550],"CY","perurot","/assets/pts/studio_CY.jpg?h=617b942741599da47637eaaf7b1c4da6",[2852,3533],"Charakterstarke Ästhetik: perurot ist ein erdiger und rot-bräunlicher Farbton, der von der peruanischen Landschaft und dessen Kultur abgeleitet ist. Die natürlich-warme Farbe ist ein nicht-metallischer Rotton, der ursprünglich auch als „Ziegelrot“ beschrieben werden kann. Der Boden in Peru und die traditionellen Gewänder wie die Ponchos weisen einen ähnlichen Rotton auf.<br><br>Die Farbe ist seit Anfang der 1970er Jahre verfügbar gewesen und hier mit dem G-Modell verbunden, der zweiten Modellgeneration des 911.<br><br>Perurot ist ein satter Farbton mit einem braunen oder rostfarbenen Unterton. Je nach Intensität und Sättigung der Farbe kann es von einem dunkleren, gedämpften Rot bis zu einem helleren, lebhaften Rotorange reichen. Perurot ist eine auffällige Farbe, die Wärme, Leidenschaft sowie Stärke vermittelt. Der Farbton kann unterschiedliche Stimmungen und eine warme Ästhetik erzeugen.","https://player.vimeo.com/video/1097504608?h=663ae37d89","#752420",[3558],"UO","rosarot","/assets/pts/studio_UO.jpg?h=9758d7744923cf22b34f13efd94e2a10",[2852,3533],"<p>Rosarot ist ein leuchtendes, energiegeladenes Rot mit einem charakteristischen pinkfarbenen Unterton – eine moderne Hommage an den historischen Porsche Farbton „fraise“, der Anfang der 1970er Jahre im Serienangebot verfügbar war.</p><p><br></p><p>Legendäre Beispiele für die historische Porsche Farbe sind der 911 Carrera RSR 3.0 und der Carrera RS 2.7, die im Jahr 1974 beim International Race of Champion (IROC) an den Start gingen.</p><p><br></p><p>Die intensive Farbwirkung von rosarot erinnert – ganz im Sinne ihres Ursprungsnamens fraise – an das satte Rot einer reifen Erdbeere, durchzogen von dem lebhaften Pink einer Himbeere. So entsteht ein Ton, der zugleich  frisch und kraftvoll wirkt und eine unverwechselbare emotionale Präsenz entfaltet.</p><p><br></p><p>Im Jahr 2025 wurde rosarot auf individuellen Kundenwunsch im Rahmen des Programms Farbe nach Wahl Plus neu entwickelt. Mit seiner lebensfrohen, expressiven Optik erweitert er seither die Palette besonderer Individualfarben und verkörpert die Verbindung aus Porsche Heritage und moderner Farbästhetik.</p>","https://player.vimeo.com/video/1163940185?h=9e83d18de2","#ae1740",[3566],"UM","nantucketrot","/assets/pts/studio_UM.jpg?h=43af4d4b8d29dd210c8aa3a38d1fe7cc",[2852,3533],"<p>Sommer, Segelsport und Insel-Flair: nantucketrot ist ein warmer, charaktervoller Rotton mit maritimem Ursprung. Sein Name geht auf die Insel Nantucket vor der Küste von Massachusetts zurück – eine Region, die für Segelkultur, sommerliche Leichtigkeit und einen entspannten, zugleich stilvollen Lebensstil steht.</p><p><br></p><p>Ursprünglich entstand der Farbton durch das Ausbleichen kräftig roter Stoffe – insbesondere solcher, die im Segelsport und im Küstenalltag verwendet wurden. Sonne, Salzwasser und häufiges Waschen ließen die kräftigen Rottöne im Laufe der Zeit zu einer staubig‑roséfarbenen, weichen Nuance verblassen. Genau dieser Used‑Look machte \"Nantucket Red\" in der Modewelt zu einem eigenständigen, ikonischen Farbtrend.</p><p><br></p><p>Das Farbe nach Wahl nantucketrot übersetzt diese Historie in eine moderne, harmonisch abgestimmte Lackfarbe. Der Ton kombiniert Rubinrot mit orangenen Akzenten und zarten Rosénuancen, wodurch eine lebendige, zugleich ruhige Farbwirkung entsteht. Unter direktem Licht entfaltet die Farbe eine dezente, natürliche Leuchtkraft, ohne je aufdringlich zu wirken – elegant, warm und voller sommerlicher Leichtigkeit.</p><p><br></p><p>Nantucketrot steht heute für Sommer, Küste, Coolness und zeitlose Eleganz – eine Farbe, die den Charme sonniger Tage, maritimer Freiheit und entspannter Exklusivität trägt.</p>","https://player.vimeo.com/video/1163940219?h=c594c1187e","#be454f",[3575],"WM","lavaorange","/assets/pts/studio_WM.jpg?h=32a7715709a9a382e227320e17037ca2",[2852,3574],"Natürliches Auffallen: lavaorange ist ein heller und intensiver Orangeton, der dem Farbnamen nach an geschmolzene Lava erinnert oder auch an einen Sonnenuntergang eines heißen Tages.<br><br>Die nicht-metallische Farbe kreiert ein auffälliges Aussehen und ist seit den 2010er Jahren als Serienfarbe bekannt. Zur Markteinführung des 911 GT3 RS (991) ist lavaorange gewählt worden und dann für den 911 als Farbauswahl zur Verfügung gestanden. Kurze Zeit später folgen die Modellreihen 718 und Cayenne. Heute ist lavaorange ein fester Bestandteil im Farbe nach Wahl Programm und erfreut Porsche Enthusiasten weltweit mit seiner positiven Wirkung.<br><br>Lavaorange ist eine leuchtende Farbe mit einem leichten gelben Unterton, der ein warmes und energiegeladenes Gefühl vermittelt. Als kraftvolle Farbe sorgt lavaorange für eine Botschaft von Leidenschaft und der Begeisterung.","https://player.vimeo.com/video/1099291531?h=6e2cfa3640","TAG5","#c62c13",[3583],"UI","kadmiumorange","/assets/pts/studio_UI.jpg?h=715e6b129ca110835b6a1bee2e163fce",[2852,3574],"<p>Auffällig extrovertiert: kadmiumorange ist ein gesättigter, warmer Orangeton mit einer deutlichen Rotnote, der seinen Ursprung in der historischen Porsche Farbe \"continentalorange\" aus den späten 1970er Jahren hat und heute, neu interpretiert, das Farbe nach Wahl Angebot bereichert.</p><p><br></p><p>Kadmiumorange wird als energetisch, lebendig und extrovertiert beschrieben. Im direkten Licht entfaltet die Farbe eine kräftige, fast glühende Präsenz und wird trotz Rotstich klar als Orange wahrgenommen. Im Schatten wirkt sie rötlicher und erinnert an den bekannten Farbton lavaorange.&nbsp;</p><p><br></p><p>Kadmiumorange&nbsp;steht für Extrovertiertheit, Energie und Performance – eine Farbe für Kunden, die bewusst auffallen möchten und eine sportliche, lebendige Farbpersönlichkeit schätzen.</p><p><br></p>","https://player.vimeo.com/video/1163939950?h=c7471cc57b","#dd430d",[3590],"I2","gulforange","/assets/pts/studio_I2.jpg?h=47c18e3c59d15b0fa18193e363ff8359",[2852,3574],"<p>Erfrischende Individualität: gulforange ist ein warmer lebendiger Orangeton, der wie gulfblau mit der Rennwagen-Lackierung von Gulf Oil verbunden ist. Ab 1972 ist gulforange als Lackfarbe auf allen 911 Modellen verfügbar, damals unter den wechselnden Farbcodes 6161, 6110 sowie 019. Zusätzlich zu seiner Assoziation zur Motorsport-Lackierung ist gulforange zu einer beliebten Farbwahl für Oldtimer und auf modernen Sportwagen avanciert. Gulforange ermöglicht ein kühnes wie unverwechselbares Erscheinungsbild, das dem Design eines Sportwagens ein Gefühl von Persönlichkeit und Individualität auf den Weg gibt.</p><p><br></p><p>Gulforange ist ein energiegeladener Orangefarbton, der allen Modellen ein erfrischendes Aussehen verleiht. Die satte, nicht-metallische Qualität strahlt Begeisterung, Aufregung sowie Abenteuer aus und kann sowohl kräftig als auch verspielt wirken. Gulforange harmoniert besonders mit Blau- und Grautönen.</p><p><br></p><p>Als Uni-Farbton ist gulforange eine von fünf Farben des Sondermodells 911 Turbo S 20 Jahre Porsche China Edition (992) aus dem Jahr 2021.</p>","#e0531e",[3598],"CW","pastellorange","/assets/pts/studio_CW.jpg?h=6f6173144c59fd6d89afa46de844d5a0",[2852,3574],"Lebendig, fröhlich, hochtourig: pastellorange ist ein einladender heller Orangefarbton, der sich in der GT-Szene einen eigenen Platz erobert hat. Die weiche Farbe ist eine der strahlendsten Orange-Töne, die Porsche im Angebot hat und verleiht jedem Modell etwas Verspieltes. Pastellorange wird mit den Jahreszeiten Frühling oder Sommer in Verbindung gebracht und vermittelt ein Gefühl von Wärme, Freundlichkeit und Fröhlichkeit.","https://player.vimeo.com/video/1098222873?h=683ac4132c","#e2610e",[3606],"XA","signalorange","/assets/pts/studio_XA.jpg?h=c26394fc3f3df28e90054db934c0d11f",[2852,3574],"Neue Wege: signalorange ist eine historische Porsche Farbe, die in den 1970er Jahren ihren Ursprung hat. Unter den Farbcodes 1414, 1410 und 116 ist signalorange auf dem 911 Coupé und Targa sowie dem 914 verfügbar gewesen.<br><br>Im Rahmen der Heritage Design Strategie präsentiert Porsche 2025 den 911 Spirit 70. Das Fahrzeugkonzept wurde durch die siebziger Jahre inspiriert und im Farbton Olive Neo kommuniziert. Der zweite Gewinner im Farbauswahlprozess für die Kleinserie war Orange, da die siebziger Jahre in Mode und vielen anderen Produktkategorien besonders mit diesem Farbton assoziiert werden. Es war dem Projektteam ein Herzenswunsch, zur Vorstellung des 911 Spirit 70 die perfekt in die Zeit passende Farbe Signalorange ins Farbe nach Wahl Programm aufzunehmen.<br><br>Der kräftige und anregende Orangefarbton reiht sich ein in die intensiven, lebendigen Töne der Porsche Farbpalette und besticht im Sonnenlicht mit einem Hauch von gelb. Signalorange strahlt Lebensfreude und Wärme aus, steht aber auch symbolhaft für Selbstvertrauen.","https://player.vimeo.com/video/1096898329?h=5436e67f0c","#dc710d",[3614],"W4","seanpeach","/assets/pts/studio_W4.jpg?h=95e50c1f2a54fd830333bd90d1bcd2d6",[2852,3574],"Frischer Impuls: der Farbton seanpeach ist ein satter Pfirsichton, der aus der exklusiven Zusammenarbeit des Sportwagenherstellers mit dem amerikanischen Designer und Influencer Sean Wotherspoon entstanden ist: Ein Art Car bestehend aus 4 Farben: nashyblue, seanpeach, lorettapurple und ashleygreen. Die Herkunft des Farbnamens seanpeach spiegelt die persönliche Bedeutung des Künstlers und Autoliebhabers zu Porsche wider: so hat der Designer die neu kreierte Farbe seanpeach einfach nach sich selbst benannt.<br><br>Im Jahr 2024 wird die satte und intensive Farbe seanpeach in das Farbe nach Wahl Produktprogramm aufgenommen und kann von allen Porsche Liebhabern bestellt werden.","https://player.vimeo.com/video/1097497405?h=70ac52b5a1","#d98357",[3622],"N7","nordischgoldmetallic","/assets/pts/studio_N7.jpg?h=7003e5573a2b561ff7f50a9946c908b3",[2842,2869],"Nordisches Gold: nordischgoldmetallic geht vermutlich auf den Farbton „Metallic Gold“ Anfang der 1970er Jahre der Modelle 911 und 914 zurück. Eine Farb-Analogie findet sich auch bei der heutigen Herstellung von Münzmetall wie den 10-, 20- und 50-Centmünzen. Die Messinglegierung „Nordisches Gold“ verleiht den Münzen eine goldgelbe Farbe und zeichnet sich durch Haltbarkeit sowie Anlaufbeständigkeit aus.<br><br>Die orange-gelbe Metallicfarbe ist gegen Ende der 2000er-Jahre auf den Modellen 911 (997), 718 (987) und dem Cayenne GTS und heute als Farbe nach Wahl Option verfügbar.<br><br>Nordischgoldmetallic ist eine warme und glänzende Farbe mit einem charakteristischen gelb-orangeroten Farbton, der der Farbe von reinem Gold ähnelt. Der helle Goldton kann stilvoll mit Luxus, Reichtum und einem Machtbewusstsein in Verbindung gebracht werden.<br><br>Nordischgoldmetallic ist eine einzigartige Farbe, die als Kommunikationsfarbe für den 911 Targa 4S (997) gewählt wurde.","https://player.vimeo.com/video/1099602053?h=82ff3b65f1","#ad6b2c",[3631],"C2","bahamagelb","/assets/pts/studio_C2.jpg?h=fbf7cc07083674a45fa4924a57c8421a",[2852,3630],"Das pure Leben: der interessante Farbton bahamagelb ist von 1965 bis 1969 verfügbar und entwickelt sich schnell zur Trendfarbe. Der helle und einladende Gelbton ist mit dem Farbcode 6805 für das F-Modell des Ur-Elfers verfügbar und wird von Porsche als Sonderfarbe angeboten.<br><br>Heute bereichert das fröhliche bahamagelb das Farbe nach Wahl Programm.<br><br>Bahamagelb als warme und lebhafte Farbe verfügt über einen leicht orangefarbenen Unterfarbton und sorgt für ein energiegeladenes Erscheinungsbild. Der Farbton wirkt verspielt, aber auch mutig und vermittelt ein Gefühl von Abenteuer und Spaß.<br><br>Ein prominentes Beispiel eines 911 in bahamagelb ist der erste Dienstwagen des damaligen Rennfahrers Jochen Rindt aus dem Jahr 1967. Rindt, der im Jahr 1970 posthum Weltmeister wurde, ist den mit 160 PS ausgestatteten 911 S in bahamagelb selbst gefahren.","https://player.vimeo.com/video/1099308504?h=4472587c2b","TAG7","#bf7a13",[3638],"ET","signalgelb","/assets/pts/studio_ET.jpg?h=0edc9c063de7029a3c4fb4516c27159c",[2852,3630],"Strahlend und begehrt: signalgelb ist eine helle Farbe und zählt als klassischer, Porsche eigener Farbton. Wie der Farbname in sich trägt, wird gelb als Signalfarbe bei Verkehrssymbolen oder Beschilderungen verwendet. Im Motorsport weist die gelbe Flagge auf Gefahrenstellen hin und fordert die Fahrer dazu auf, langsamer zu fahren oder sich auf einen möglichen Stopp vorzubereiten.<br><br>Signalgelb ist ab Mitte der 1960er Jahre bis Anfang der 1970er Jahre in sechs unterschiedlichen Farbcodes für den 911 und den 912 verfügbar. Im Jahr 2009 kehrt die Farbe dank der japanischen Rennsportlegende Tetsu Ikuzawa zurück: Er lässt seinen signalgelben 911 Targa aus dem Jahr 1969 restaurieren und bestellt zusätzlich einen damals neuen 911 Targa 4S (997) in signalgelb.<br><br>Signalgelb ist eine aufmerksamkeitsstarke Farbe mit einem erkennbaren Rotanteil. Der Farbton symbolisiert Glück, Optimismus sowie Kreativität und spricht Gefühle von Wärme, Energie und Aufregung an.","#f4960e",[3646],"X1","atakamagelb","/assets/pts/studio_X1.jpg?h=3521fa702e6c7aee4639f730f4d02eb5",[2852,3630],"Leuchtende Besonderheit: atakamagelb ist ein satter Gelbfarbton, dessen Name und Wirkung eine Anlehnung an die Atacama Wüste im nördlichen Chile ist. Der Farbton erinnert an die außergewöhnliche Farbpracht der Wüste im Abendlicht.<br><br>Atakamagelb ist eine leuchtende Farbe, die ursprünglich auf individuellen Kundenwunsch über den Farbe nach Wahl Plus Prozess umgesetzt wurde.<br><br>Der Farbton strahlt Optimismus und ein eigenes Gefühl von Wärme aus. Bei geringerer Lichteinstrahlung kommen vor allen die orangenen Untertöne gut zur Geltung. Atakamagelb erinnert an das bekannte signalgelb, ist jedoch heller in der Wirkung.","https://player.vimeo.com/video/1099304286?h=beb53b9f30","#ea9e0d",[3654],"TC","solergelbmetallic","/assets/pts/studio_TC.jpg?h=4fa896ecdc4efd2be94470b69f09c320",[2842,3630],"<p>In seiner Musik lässt Alvaro Soler pure Leichtigkeit und Lebensfreude erklingen. Aber nicht nur auf der Bühne trifft der Sänger und Songwriter die richtigen Töne, sondern auch bei der Wahl der Lackfarbe. Das zeigt seine eigens kreierte Farbe solergelbmetallic.&nbsp;</p><p><br></p><p>Inspiriert vom ikonischen bahamagelb, das ihn schon als Kind auf dem Poster eines alten F-Modells begeistert hat, bringt die nach dem Musiker benannte Farbe das gesamte Lebensgefühl seiner Musik auf die Karosserie und auf die Straße. Mit einem strahlenden Metallic-Finish, das jede Fahrt ein bisschen heller macht.</p><p><br></p><p>Das exklusive solergelbmetallic ist ab sofort im Farbe nach Wahl Programm erhältlich. Die ideale Wahl für alle Fans von Porsche, Alvaro Soler – und dem Gefühl grenzenloser Freiheit.</p>","https://player.vimeo.com/video/1163940248?h=49c2525be0","#e4950d",[3661],"JC","speedgelb","/assets/pts/studio_JC.jpg?h=6ffe1a95a7ee4b4618dd5acba47e14b1",[2852,3630],"<p>Sonniges Gelb: speedgelb ist ein heller und lebendiger Porsche Gelbton, der von den 1990er Jahren bis 2012 als Serienfarbe angeboten wurde. Der Farbton ist unter den Farbcodes 12G und 12H auf den 911 und 718 Modellen 993, 996, 986 und 987 sowie dem 968 verfügbar gewesen.</p><p><br></p><p>Speedgelb ist ab der siebten 911 Generation (991) durch racinggelb ersetzt worden, das bis heute den Platz des Standardgelbs eingenommen hat.</p><p><br></p><p>Speedgelb kann als warmes Sonnengelb mit einem leichten orangefarbenen Unterton beschrieben werden, der zwischen racinggelb und signalgelb liegt. Die stark gesättigte Farbe verkörpert einen intensiven Ausdruck und neigt dazu, sich von ihrer Umgebung abzuheben. Als kräftige, energiegeladene Farbe wird mit speedgelb ein Gefühl von Geschwindigkeit, Kraft und Aufregung assoziiert.</p><p><br></p><p>Speedgelb kommt durch seine prägnante Farbbrillanz gerne bei Pressefahrveranstaltungen zum Einsatz und ist ein beliebtes Motiv auf Magazintiteln.</p>","#e3a70e",[3670],"F2","dunkelolivmetallic","/assets/pts/studio_F2.jpg?h=f1ed7647b2f483728642271599343685",[2842,3669],"Stimmung in Fülle: dunkelolivmetallic ist eine raffinierte Farbe, mit der sich vielfältige Stimmungen und Stile in einem Design erzeugen lassen. Der dunkle Grünfarbton spiegelt die Farbe schwarzer Oliven wider, dessen Farbintensität grundsätzlich von dunkelgrün bis schwarz reicht. Mit ihrer angenehmen Ausprägung strahlt dunkelolivmetallic nicht nur Bodenständigkeit und Stabilität aus, sondern ist auch eine regelrechte Statement-Farbe.<br><br>Dunkelolivmetallic ist mit dem 911 Turbo S (996) Ende der 1990er Jahre eingeführt worden und später sowohl auf dem 911 (997) als auch für die 718 Modellreihen Boxster und Cayman (987) verfügbar gewesen.<br><br>Je nachdem, wie Licht und Schatten auf das Fahrzeug treffen, kann dunkelolivmetallic von schwarz bis gold-grün schimmern. Durch starke Flakes im Lack kann ein „Flop-Effekt“ sichtbar werden, der einen bleibenden Eindruck hinterlässt.","https://player.vimeo.com/video/1099295435?h=e405e9bf17","TAG11","#191b19",[3678],"NV","verdezeltwegmetallic","/assets/pts/studio_NV.jpg?h=12c1ff57322a93f5b745aafab112c621",[2842,3669],"Exklusiv, unverwechselbar und einzigartig begehrenswert: Verdezeltwegmetallic ist ein tiefes, sattes Grün mit einem deutlichen gelben Unterton, durch das metallische Finish wirkt der Grünton lebendig und energiegeladen.<br><br>Das oft als Renngrün bezeichnete verdezeltwegmetallic ist nach dem Flugplatz Zeltweg in Österreich benannt und wurde auf individuellen Wunsch eines Kunden bei Porsche im Farbe nach Wahl Plus Prozess nachgestellt.<br><br>Die Farbe verleiht ein luxuriöses Aussehen und bleibt ein unverwechselbarer Blickfang, die Assoziation mit Rennen, Geschwindigkeit und Individualität bleibt unverkennbar.","https://player.vimeo.com/video/1097459024?h=da66be191b","#1f2b28",[3686],"J8","jetgrünmetallic","/assets/pts/studio_J8.jpg?h=a00932fd70ebe66d831c98310d6691f1",[2842,3669],"<p>Atemberaubend: jetgrünmetallic ist eine Porsche Farbe, die bei der ersten und zweiten Generation des 2009 eingeführten Panamera (970) als Standardfarbe verfügbar war. Wenig später ist der dunkelgrüne Farbton auch für den Cayenne angeboten worden.</p><p><br></p><p>Vergleicht man die Farbe mit tannengrünmetallic und porscheracinggrünmetallic, besitzt jetgrünmetallic den meisten Blauanteil und auch die höchste Leuchtkraft.</p><p><br></p><p>Jetgrünmetallic ist ein intensives Dunkelgrün. Der Farbton sticht nicht hervor, fällt durch den beeindruckenden metallischen Schimmer dennoch auf. Jetgrünmetallic wird durch seine Farbintensität gerne als Farbe nach Wahl gewählt. In Kombination mit Gold kann mit jetgrünmetallic ein starker Kontrast erzielt werden.</p>","https://player.vimeo.com/video/1098217630?h=30cb92eecf","#152f2c",[3694],"DI","porscheracinggreenmetallic","/assets/pts/studio_DI.jpg?h=17f9ea96523929d88a7a946dc7001a87",[2842,3669],"<p>Moderne Interpretation: porscheracinggreenmetallic ist ein tiefer Grünfarbton und eine Adaption des klassischen britishracinggreen, der ein metallisches Finish hinzugefügt wurde. Durch die historische Farb-Verbindung zu Rennfahrzeugen bringt der schillernde Effekt ein zeitloses Erscheinungsbild zur Geltung und betont den klassischen Fahrzeugcharakter.</p><p><br></p><p>Von 2009 an ist porscheracinggreenmetallic für die zweitürigen Sportwagen-Modelle 911 (997) und 718 Boxster/Cayman (986, 987) für wenige Jahre verfügbar gewesen. Die Farbe ist auch unter „Racing Grün Metallic“ mit dem Farbcode 22G gelistet.</p><p><br></p><p>Porscheracinggreenmetallic ist ein satter Grünton mit metallischem Finish, der eine schimmernde, reflektierende Qualität aufweist. Der Grünton kann je nach Lichtverhältnissen leicht variieren, hat einen dunklen und intensiven Farbton mit einem subtilen Hauch von blauen Untertönen. Porscheracinggreenmetallic hat ein elegantes Auftreten und suggeriert eine Vornehmheit, die Tradition und Innovation verschmelzen lässt.</p>","https://player.vimeo.com/video/1205432817?h=6cadbeb3b8","#1d3231",[3702],"X6","arlogrünmetallic","/assets/pts/studio_X6.jpg?h=7cb57116b773c9127a9f35bd6597abcb",[2842,3669],"Treuer Begleiter: Arlogrünmetallic ist ein kraftvolles und lebendiges Grün, dessen Entwicklung auf eine individuelle Fahrzeugbestellung zurückzuführen ist. So hat ein Autoenthusiast und Porsche Liebhaber den besonderen Farbton über das Farbe nach Wahl Plus Programm gemäß seinen Wünschen umsetzen lassen. Auch der Name der Farbe ist auf Kundenwunsch entstanden: „Arlo“ ist der Hund und treue Wegbegleiter des Kunden, dessen lebendiger Charakter perfekt zum neuen Porsche Farbton passt.<br><br>Optisch ist arlogrünmetallic an den Edelstein des grünen Turmalins angelehnt, der für seine einzigartige Farbbrillanz bekannt ist. Der satte Grünton zeigt insbesondere bei Sonnenlicht seinen blau-türkisfarbenen Unterton und wirkt dadurch spannend, dynamisch und belebend.","https://player.vimeo.com/video/1097455962?h=8100b3f4b7","#143038",[3710],"X5","amazonasgrünmetallic","/assets/pts/studio_X5.jpg?h=252e33a7283c259d81c50be59d21eb22",[2842,3669],"Blau trifft grün: wie amazonasgrünmetallic im Namen trägt, spiegeln sich in diesem historischen Farbton die großartige Naturlandschaft und das lebendige Farbspektrum des Amazonasgebietes wider.<br><br>Der markante und naturverbundene Farbton ist als Amazonasgrün Perlcolor bereits Anfang der 1990er Jahre auf den Modellreihen 928, 968 und 964 verfügbar gewesen und bereichert das Farbe nach Wahl Angebot seit dem Jahr 2025 mit seiner Farbtiefe.<br><br>Amazonasgrünmetallic ist eine schimmernde und einprägsame Farbe, die mehr blau als grün wirkt und eine unaufgeregte Gelassenheit ausstrahlt.","https://player.vimeo.com/video/1097457986?h=2561e8af8e","#0d303d",[3717],"F7","fjordgrün","/assets/pts/studio_F7.jpg?h=ad59b6b78dae023fcb53bbf74af798cd",[3669,2852],"<p>Faszinierende Mitte: inspiriert von der beeindruckenden Farbpracht der norwegischen Küstenlandschaft, der Wälder und Gewässer vermittelt fjordgrün eine entspannende, ausgleichende Kraft.</p><p><br></p><p>Der facettenreiche Grünfarbton ist eine Lackierung des Porsche 356 A, die ab dem Modelljahr 1956 angeboten wurde und den Farbcode 6005 besaß.</p><p><br></p><p>Fjordgrün ist ein komplexer und faszinierender Grünton, der eine außergewöhnliche Naturlandschaft in sich vereint: die Farben des tiefen Wassers in einem Fjord, einem engen Meeresarm, der von steilen Klippen oder Bergen an den Küsten Skandinaviens umgeben ist. Der Farbton ist eine fast blaue, aber immer noch grüne, vielschichtige Farbe, die eine ruhige Qualität verkörpert – damit an die Gelassenheit und natürliche Schönheit eines Fjords erinnert.</p>","#0d2c33",[3725],"JN","tannengrünmetallic","/assets/pts/studio_JN.jpg?h=90ea50b02ce153f1fd6493e14944c96f",[2842,3669],"Natur pur: tannengrünmetallic ist ein dunkler und satter Grünton, dessen Name von den Farben eines dicht bewachsenen Waldes inspiriert ist.<br><br>Die historische Porsche Farbe ist erstmals Ende der 1980er Jahre beim 911 Modell vom Typ 964 erschienen. Es folgt die Verfügbarkeit von tannengrünmetallic für 993 und 996 sowie für das 718 Modell 986. Ab Ende der 1990er Jahre wird der Farbcode in 2B4 geändert und es kommt das 718 Modell 987 hinzu.<br><br>Tannengrünmetallic ist ein dunkelgrüner Farbton mit einem niedrigen bis mittleren Sättigungsgrad. Der Farbton kann subtile Untertöne anderer Farben wie Braun oder Blau aufweisen, die ihm einen leicht erdigen oder kühlen Ton verleihen. Die beruhigende Farbe gehört zu den dunkleren Grüntönen, die von Porsche angeboten werden und ist vergleichbar mit jetgrünmetallic, aber mit einem stärkeren Braunstich. Tannengrünmetallic kann mit einem Aufenthalt in der freien unberührten Natur assoziiert werden und ruft Gefühle der Ruhe und Gelassenheit hervor.","https://player.vimeo.com/video/1097432166?h=6250797605","#202e2d",[3733],"NU","verdebritishracinggreen","/assets/pts/studio_NU.jpg?h=e7637737a0e62033f17d2f7710804ac1",[3669,2852],"Verdebritishracinggreen ist eine satte und tiefe dunkelgrüne Farbe, die oft mit Geschwindigkeit, Leistung und Luxus assoziiert wird.<br><br>Der Farbton wurde auf individuellen Wunsch eines Kunden über das Farbe nach Wahl Plus Programm entwickelt und später ins Farbe nach Wahl Programm übernommen.<br><br>Verdebritishracinggreen hat einen bläulich-dunklen Unterton mit einem Hauch von Gelb, der der Farbe bei Sonneneinstrahlung Tiefe und Lebendigkeit verleiht. Insgesamt ist verdebritishracinggreen eine anspruchsvolle und zeitlose Farbe, die Eleganz und Prestige ausstrahlt.","https://player.vimeo.com/video/1097527993?h=40dff15840","#14221c",[3741],"C8","brewstergreen","/assets/pts/studio_C8.jpg?h=848639a63a77621e3cc592f83839fa08",[3669,2852],"Familientradition: sowohl die Dienstwagen von Ferry Porsche als auch die meisten 911 Fahrzeuge der Nachfahren haben eines gemeinsam – sie sind häufig in dezenten und elegant wirkenden Grünfarbtönen lackiert. Dr. Wolfgang Porsche führt diese Modelltradition beispielsweise in brewstergreen, britishracinggreen und irishgreen bis heute fort.<br><br>Brewstergreen wurde auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und hat sich neben oakgrün in den vergangenen Jahren zu den populärsten Farbe nach Wahl Optionen entwickelt. Als Farbe nach Wahl ist brewstergreen für alle Modelle, ausgenommen die Modellreihe Cayenne, erhältlich.<br><br>Brewstergreen spiegelt einen tiefen Grünton wider, der an Wälder und unberührte Naturlandschaften erinnert. Der anspruchsvolle wie zeitlose Farbton hat ein komplexes und nuanciertes Erscheinungsbild mit einem tiefgrünen Farbansatz, der einen leichten blau-grauen Unterton aufweist. In bestimmter Umgebung wirkt brewstergreen annähernd schwarz und bringt im richtigen Licht den Grünton zur Geltung.<br><br>In Anlehnung an die grüne Farbtradition der Familie Porsche sowie zu Ehren der ersten Porsche Club Gründungsmitglieder ist zum 60-jährigen Jubiläum der weltweiten Porsche Clubs das 911 Club Coupe aufgelegt worden. Das Sondermodell der Exclusive Manufaktur (Typ 991) in brewstergreen ist auf 13 Einheiten limitiert und konnte nur von Porsche Club-Mitgliedern erworben werden.","https://player.vimeo.com/video/1097496259?h=20ddf7bd6e","#19231e",[3749],"JV","underberggrün","/assets/pts/studio_JV.jpg?h=58cd4df2c7d4b2a10e0661f5d9b1e4bc",[3669,2852],"Blätterwald: underberggrün ist ein moderner und spannender Grünton, der sowohl die Firmenfarbe als auch den Namen der Schweizer Unternehmer-Familie repräsentiert. Die kräftige und auffällige Grünfarbe stammt vom Firmenlogo und der Lackierung der Lieferwagen des Magenbitter-Herstellers Underberg.<br><br>Underberggrün wurde auf persönlichen Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses entwickelt und ist heute im Farbe nach Wahl Angebot enthalten.<br><br>Der Farbton underberggrün kann je nach Lichteinfall leicht variieren, ist aber ein dunkles, sattes Grün, das der Farbe immergrüner Bäume oder dunklem Waldlaub ähnelt. Als tiefer und lebendiger Grünton vermittelt die Farbe ein Gefühl von Kultiviertheit, Qualität und Tradition.","https://player.vimeo.com/video/1099298206?h=d5c512738d","#262f23",[3757],"X0","quercusverde","/assets/pts/studio_X0.jpg?h=1b1005bc93a2728dcf412df79c17bff4",[3669,2852],"Iberischer Charakter: quercusverde ist der neue Farbton der Porsche Cuarenta Edition, die im Jahr 2024 anlässlich des 40-jährigen Jubiläums der Tochtergesellschaft Porsche Ibérica als Markt Edition vorgestellt wurde.<br><br>Die Außenfarbe wurde im Rahmen des Farbe nach Wahl Plus Programms kreiert und erinnert an den besonderen Farbton von Steineichenblättern, dessen grüne Farbe charakteristisch für die spanische und portugiesische Landschaft ist.<br><br>Quercusverde ergänzt das Farbe nach Wahl Programm durch einen satten mittelgrünen Unilack, der durch seine Tiefenwirkung beeindruckend modern und zeitlos zugleich wirkt.","https://player.vimeo.com/video/1097456835?h=45b241f356","#2b3623",[3764],"N8","oakgrünmetallic","/assets/pts/studio_N8.jpg?h=be3c989907f9beefc05ab57b2524d1a3",[2842,3669],"Der Turbo: oakgrünmetallic ist ein klassischer Porsche Farbton, der ein mittleres Grünmetallic mit einem Hauch von Goldgrau darstellt. Der warme Grünton ähnelt in seiner Farbe den satten grünen Blättern einer Eiche im Frühling und Sommer. Das mittlere Grünmetallic ist bis Mitte der 1990er Jahre für viele Porsche Modelle angeboten worden.<br><br>Oakgrünmetallic ist ein tiefer und gedämpfter Grünton mit einem leicht gelblichen oder bräunlichen Unterton, der ihm ein natürliches und erdiges Aussehen verleiht. Die vielseitige Farbe kann ein Ambiente von Harmonie, Ausgeglichenheit und Entspannung erzielen.<br><br>Der 911 Turbo 3.0 (Typ 930) hat bei seiner Vorstellung in oakgrünmetallic Bekanntheit erlangt. Angelehnt an dieses Modell von Dr. Ferry Porsche aus 1976 hat Porsche im Jahr 2024 eine eigene Sneaker-Serie mit dem Sportartikelhersteller Puma veröffentlicht. Das Design des „Turbo 930“ Sneaker wurde zu Ehren von Dr. Ferry Porsches Turbo-Fahrzeug von 1976 entwickelt und in oakgrünmetallic designt.","#363d34",[3772],"EI","schwarzoliv","/assets/pts/studio_EI.jpg?h=ef0a2d138f940229aaa940f5c0266fe4",[3669,2852],"Unaufdringlich natürlich: schwarzoliv ist ein dunkler, gedämpfter Grünton, der an die Farbe von reifen schwarzen Olivenfrüchten erinnert. Der nicht-metallische dunkle Grünton ist vielseitig und eine interessant wirkende Farbe.<br><br>Der Farbton ist als Farbe nach Wahl für den Porsche 911 zuerst 2006 und dann nochmal im Jahr 2018 verfügbar gewesen.<br><br>Schwarzoliv ist eine neutrale Farbe mit einem bräunlichen oder gräulichen Unterton. Das matte Finish des dunklen Grüns umhüllt den Sportwagen mit einer warmen und erdigen Atmosphäre. Schwarzoliv wirkt einladend und entfaltet in seiner Einfachheit eine dezente, zeitlose Eleganz. Der Farbton wird durch seine Ausstrahlung mit natürlichen und organischen Materialien in Verbindung gebracht.","https://player.vimeo.com/video/1097431398?h=05b81a10eb","#36392e",[3780],"F4","felsengrünmetallic","/assets/pts/studio_F4.jpg?h=5b1404a8224c17b227e6fbd1716bf2d8",[2842,3669],"<p>Einzigartig attraktiv: felsengrünmetallic ist eine außergewöhnliche Farbe, für die sich Porsche Kunden seit Ende der 1980er Jahre begeistern. Der Farbton wirkt natürlich, erdig und steht für Ausgeglichenheit, Harmonie und Wachstum. Die Farbe selbst ähnelt grünem Granit – einer grobkörnigen magmatischen Gesteinssorte, die über eine überwiegend grüne Farbe mit silbergrauen Farbtönen verfügt sowie verschiedene Schattierungen von hell bis dunkel aufweist.</p><p><br></p><p>Erstmalig ist felsengrünmetallic unter dem Farbcode 699 bei den Modellen 911 und 928 verfügbar. Felsengrünmetallic ist ein rauchiges Grau mit einem Hauch von Grün. Je nach Mineralzusammensetzungen kann das Gestein einzigartige Muster und Variationen entfalten sowie eher blau oder gelbgrün erscheinen. Die Farbe wird gerne für dekorative Akzente sowohl im Innen- als auch im Außendesign verwendet.</p>","https://player.vimeo.com/video/1097529753?h=ccec91b4a8","#6d6f68",[3788],"M8","natooliv","/assets/pts/studio_M8.jpg?h=59cb1c9c2a2ee012cc82f82329080e31",[3669,2852],"Zweckmäßig, funktional und robust: natooliv ist nicht nur ein einzigartiger Farbname, er ist auch von der klassischen Militärfarbe NATO-Olivgrün inspiriert, die für militärische Ausrüstung verwendet wird. Die North Atlantic Treaty Organization (NATO) mit Sitz in Brüssel verwendet ebenso wie die nationalen Militärorganisationen bestimmte Textilfarben, die einem RAL-Farbton zugeordnet sind. Im allgemeinen Sprachgebrauch wird Militärgrün auch als „NATO-oliv“ oder „NATO-grün“ bezeichnet, die in der Bundeswehr auch als „steingrauoliv“ bekannt sind.<br><br>Natooliv ist ein dunkler, erdiger Grünton mit einem leicht gelblichen oder bräunlichen Unterton. Das robuste Aussehen vermittelt einen Bezug zu Outdooraktivitäten und ist beliebt, wenn ein klassischer Look sowohl stilvoll als auch funktional sein soll.","https://player.vimeo.com/video/1097535643?h=7aa03005b1","#3b3f2d",[3796],"UJ","graphitgrünmetallic","/assets/pts/studio_UJ.jpg?h=03cd05912901095c53168abbb40547a0",[2842,3669],"<p>Inspiration Natur:<em>&nbsp;</em>Graphitgrünmetallic&nbsp;ist ein tiefes, sattes Dunkelgrün,&nbsp;das seine Inspiration aus der Verbindung von natürlichem Waldgrün und mineralischer Graphitstruktur zieht. Der Farbton erinnert an dunkles Tannengrün, das mit dem kühlen, leicht rauchigen Charakter von Graphit verschmilzt – von moosbewachsenen Felsen über schattige Baumrinden bis hin zu einem gedämpften Grün im fahlen Abendlicht.</p><p><br></p><p>Im Schatten wirkt die Farbe nahezu geheimnisvoll dunkel und ruhig.&nbsp;Unter direktem Licht entfaltet sie feine, lebendige Metallicpartikel, die in subtilen Grünnuancen schimmern. Leichte graue Untertöne und ein Hauch warmer Ockerpartikel verleihen dem Farbton Tiefe und eine elegante Komplexität.</p><p><br></p><p>Graphitgrünmetallic&nbsp;steht für ein reiches, natürliches Grün mit einer dezenten visuellen Dynamik – ausdrucksstark, ohne aufdringlich zu sein, und perfekt für Kunden, die eine exklusive, dennoch zeitlose Farbwahl bevorzugen.</p>","https://player.vimeo.com/video/1205435044?h=254b509bd4","#343a36",[3804],"K9","malachitgrünmetallic","/assets/pts/studio_K9.jpg?h=e6b3968329b9d507c7801f6db3daab7f",[2842,3669],"Wohltuende Harmonie: malachitgrünmetallic ist ein grün-grauer Farbton, der als Sonderfarbe auf dem 718 Boxster/Cayman (987) sowie dem 911 (997) Anfang der 2000er Jahre angeboten wurde. Die moderne Farbe orientiert sich am Halbedelstein Malachit, der eine satte und kräftig grüne Farbe repräsentiert. Der Naturstein wird häufig als Schmuckstein verwendet und ist für seine einzigartigen Muster in helleren sowie dunkleren Grüntönen bekannt, die sich in seinem Entstehungsprozess bilden.<br><br>Malachitgrünmetallic ist ein intensiver Ton, der den Farbbereich der mittleren bis dunklen Grüntöne abdeckt. Der Farbton ist ein salbeiartiges Grün, das heller erscheint als die anderen beliebten Grünmetallic-Lackierungen wie tannengrünmetallic oder jetsetgrünmetallic. Der genaue Farbton von malachitgrünmetallic kann je nach Kontext variieren und wird oft mit Natur, Wachstum und Wohlstand in Verbindung gebracht.","https://player.vimeo.com/video/1097433361?h=b4ac2a76ae","#4a5753",[3812],"TE","verdeermesmetallic","/assets/pts/studio_TE.jpg?h=663839ebfc47848e255e7243a87a2146",[2842,3669],"<p>Spannendes Wechselspiel: Verdeermesmetallic, ein satter Grünton, der ursprünglich im Rahmen des Farbe nach Wahl Plus Prozesses individuell auf Kundenwunsch entwickelt wurde. Der kräftige, tiefdunkle und elegante Basiston entfaltet unter Lichteinfall einen lebendigen gold‑grün schimmernden Effekt, der dem Fahrzeug eine außergewöhnliche Tiefe und Brillanz verleiht.</p><p><br></p><p>Die Farbe lebt von ihrem spannenden Wechselspiel: dunkel und kraftvoll im Schatten, strahlend und warm bei Lichteinfall. So entsteht ein luxuriöser, dynamisch changierender Farbeindruck, der dem Fahrzeug eine ebenso edle wie unverwechselbare Präsenz verleiht.</p>","https://player.vimeo.com/video/1163940078?h=0d29571102","#334620",[3820],"J4","irischgrün","/assets/pts/studio_J4.jpg?h=11b7f26aa16518dfe3c2c66e2916ba9c",[3669,2852],"Die Lieblingsfarbe: irischgrün ist ein satter Grünton, der eine Porsche Familienfarbe darstellt. Im Jahr 1963 ist der erste Serien-Porsche vom Typ 901 in irischgrün lackiert worden – für den späteren Besitzer Ferdinand „Ferry“ Porsche. 1964 wird die Farbe mit dem Farbcode 6406 für den 356 C verfügbar.<br><br>Der ikonische Grünton wird wegen seiner historischen Bedeutung und Seltenheit geschätzt und prägt die Farblandschaft der Sportwagenschmiede bis heute.<br><br>Irischgrün ist ein mittlerer und nicht-metallischer Farbton, der mit der tiefgrün gefärbten Vegetation in Irland in Verbindung steht. Der natürliche Grünton hat einen leichten gelben Unterton, der ihm ein warmes und erdiges Aussehen verleiht. Irischgrün ist eine unverwechselbare wie einprägsame Farboption.<br><br>2017 läuft der einmillionste Porsche 911 im Werk Zuffenhausen vom Band – es ist ein Carrera S (991) in irischgrün, ein Unikat mit zahlreichen exklusiven Sonderausstattungen. „Das war die Lieblingsfarbe meines Vaters. Und meine ist es auch“, sagt Porsche Enkel Wolfgang.","https://player.vimeo.com/video/1098212797?h=4d3c706d24","#1a3826",[3827],"C9","britishracinggreen","/assets/pts/studio_C9.jpg?h=39b7746ed18aff3c66d19872a9bffeb9",[3669,2852],"Fesselndes Aussehen: britishracinggreen ist ein traditioneller tiefgrüner Farbton, der sich von der grünen Farbe des Motorsports im Vereinigten Königreich ableitet. Rennwagen in britishracinggreen konnten bei den ersten Autorennen zu Beginn des 20. Jahrhunderts jeweils Spitzenpositionen erobern. Der Ursprung des Farbnamens britishracinggreen geht auf den Gordon Bennett Cup zurück: weil Großbritannien nach dem ersten Sieg im Jahr 1902 das nächste Rennen nicht ausrichten konnten, ist der Austragungsort nach Irland verlegt worden. Als Hommage an das Gastgeberland ist der olivgrüne Rennwagen in ein „kleeblattgrün“ geändert worden.<br><br>Die Farbe ist bei Porsche bereits Ende der 1980er Jahre verfügbar gewesen und kann aktuell über das Farbe nach Wahl Programm bestellt werden.<br><br>Britishracinggreen ist eine vielseitige Farbe, die einen leicht blau-grauen Unterton und feine schwarze Nuancen aufweist. Sie gilt als klassische Fahrzeugfarbe und strahlt eine zeitlose Qualität aus, die einen unaufdringlichen wie geschmackvollen Eindruck hinterlässt.","#1f3527",[3835],"NS","audraingrünmetallic","/assets/pts/studio_NS.jpg?h=a06cf1447267894e3e5ee1ef37ca21d2",[2842,3669],"Einzigartig und temperamentvoll: audraingrünmetallic ist ein lebhaftes metallisches Dunkelgrün, das als Farbe nach Wahl Plus Farbton für den Besitzer des Audrain Auto Museums umgesetzt wurde und im Jahr 2024 ins Farbe nach Wahl Programm überführt wurde.<br><br>Die Inspirationsgeber für die Farbe audraingrünmetallic sind die Logo-Farben des Audrain Auto Museums – dessen Name auch Namensgeber für den neuen Farbton ist - und die Farbe lagogrünmetallic des 356, die zu einer der ersten Metallicfarben in der Farbpalette von Porsche zählt.<br><br>Audraingrünmetallic ist ein dunkelgrüner Farbton und beinhaltet ein interessantes metallisches Blaugrün. Dieses lebhafte metallische Dunkelgrün entstand durch eine Zusammenarbeit mit dem Automuseum, das Ende 2018 mit „70 Jahre Exzellenz“ eine Ausstellung zum Porsche Jubiläum zeigte und die andauernde Erfolgsgeschichte der Sportwagenmarke aus Zuffenhausen beleuchtete.","https://player.vimeo.com/video/1097457158?h=4d879c6f2e","#28493c",[3843],"FV","smyrnagrün","/assets/pts/studio_FV.jpg?h=fdb8b2cf0dbc05925e99345e88ad7fd8",[3669,2852],"Smyrnagrün ist ein helles, nicht-metallisches Grau-Grün, dessen Farbname sich vermutlich von der historischen griechischen Stadt Smyrna und ihrem kulturellen Erbe ableitet.<br><br>Der Farbton ist eine historische Porsche Serienfarbe und ab 1962 auf dem 356 B unter dem Farbcode 6210 sowie R744 verfügbar gewesen.<br><br>Smyrnagrün verfügt über einen mintgrünen Unterton, der aber nicht so stark leuchtend ist und in der Gesamtwirkung als zurückhaltend und außergewöhnlich wahrgenommen wird.","https://player.vimeo.com/video/1099308688?h=87102b506b","#204642",[3850],"B8","auratiumgrün","/assets/pts/studio_B8.jpg?h=71b0176049476f2e45ad7478a2100a47",[3669,2852],"Zarte Blüte: auratiumgrün ist in vielerlei Hinsicht ein echter Hingucker und eine historische Bereicherung für das Farbe nach Wahl Programm.<br><br>Der Farbton gehört zu den ersten vier Sonderfarben des 356 aus dem Jahr 1957 – eine wahre Porsche Sonderfarbe. Die historische Fahrzeugfarbe war zunächst nur für wenige Jahre Ende der 1950er Jahre verfügbar und deshalb ursprünglich auch nur auf den 356-Modellen zu finden.<br><br>Das helle, bonbonartige bis liebliche Grün geht vermutlich auf eine in Japan beheimatete Lilienart zurück und ist von ihrem zarten Grünton inspiriert. Auratiumgrün ist ein mittleres Grün mit wenigen grauen Untertönen.","#456046",[3856],"olivgrün","/assets/pts/studio_O1.jpg?h=f04c0dff9b5f4698bfe4051d70b67cb4",[3669,2852],"<p>Erdiges Grün: im Farbnamen selbst ist der Farbton und dessen Bedeutung oftmals schon beschrieben, so auch bei olivgrün. Die warme Farbe ist angelehnt an die Tönung der gelblich-grünen Früchte des Olivenbaums, die ein natürliches und dezentes Aussehen verleiht. „Oliva“ umfasst im Lateinischen sowohl die Bezeichnung für den Olivenbaum als auch der Olive, dessen Frucht.</p><p><br></p><p>Olivgrün ist ein erdiger Grünton mit einem leicht bräunlichen oder gelblichen Unterton, der einen charmanten Auftritt verleiht. Assoziationen zu Stärke, Widerstandsfähigkeit und Verbundenheit mit der Natur ruft dieser klassische wie zeitlos wirkende Farbton hervor.</p>","#53663a",[3864],"X3","ashleygreen","/assets/pts/studio_X3.jpg?h=aa8cc27b0d82304e774db796d302bb4f",[3669,2852],"Inspirierend neu: ashleygreen ist ein matt wirkendes mittleres Grün, das aus der exklusiven Zusammenarbeit des Sportwagenherstellers mit dem amerikanischen Designer und Influencer Sean Wotherspoon entstanden ist: ein Art Car bestehend aus den Farben nashyblue, seanpeach, lorettapurple und ashleygreen.<br><br>Die Herkunft des Farbnamens ashleygreen hat dabei einen ganz persönlichen Bezug zum Designer, so hat Sean Wotherspoon die neu kreierte Farbe nach seiner Frau benannt. Im Jahr 2025 wird das modern anmutende ashleygreen in das Farbe nach Wahl Produktprogramm aufgenommen und kann von allen Porsche Liebhabern bestellt werden.","https://player.vimeo.com/video/1097454575?h=826d096bdb","#5c804f",[3872],"GT","weidengrün","/assets/pts/studio_GT.jpg?h=c7ae3d116016e9a456357d1c4b2878ca",[3669,2852],"Beruhigend und sanft: weidengrün ist ein weicher und beruhigender Grünton, der nach dem Weidenbaum benannt ist. Der Baum ist für seine langen, schlanken Blätter und Äste bekannt, die sich sanft im Wind wiegen - sowie dessen Laub, die eine bräunlich-grüne bis gelbe Färbung entwickeln.<br><br>Die Farbe ist eine historische Porsche Farbe, die Anfang der 1970er Jahre mit dem Farbcode 4310 / 223 / L63K auf dem 914 verfügbar war.<br><br>Weidengrün ist eine kräftige und gleichzeitig unaufdringliche Farbe mit subtilen grauen oder braunen Untertönen, die ihr eine leicht erdige Note verleihen. Weidengrün kann in seiner Intensität von einem pastellfarbenen Mittelgrün bis hin zu einem dunkleren, satteren Farbton wahrgenommen werden. Insgesamt strahlt weidengrün Ruhe und Harmonie aus.","https://player.vimeo.com/video/1098214364?h=14660f3a5c","#4c7324",[3880],"NM","essmanngrün","/assets/pts/studio_NM.jpg?h=fcda6f26ca10ab59d325c0022695240b",[3669,2852],"Leuchtend schön: essmanngrün ist ein strahlend satter Grünton, der in Zusammenarbeit mit dem Unternehmer Michael Essmann entwickelt wurde. Das erste essmanngrüne Porsche Modell ist bereits im Jahr 1992 entstanden, als der Familienunternehmer Essmann einen 911 Carrera RS 3.6 (964) in der Firmenfarbe seines Meisterbetriebs für Elektroinstallationen und Photovoltaikanlagen lackieren ließ. Es folgen weitere Fahrzeuge, darunter ein 911 GT3 RS 4.0 (997) sowie ein 911 GT3 Touring (992).<br><br>Auch die Söhne Mike und Stefan Essmann haben eine besondere Beziehung zum Sportwagenhersteller und nehmen erfolgreich am Porsche Sports Cup teil – in Rennwagen, die essmanngrüne Akzente tragen.<br><br>Der langjährige Porsche Liebhaber und Geschäftsführer Essmann hat sich im Rahmen des Farbe nach Wahl Plus Programms also seinen ganz individuellen Farbton anfertigen lassen. Und heute ist essmanngrün für alle Kunden verfügbar – denn der Farbton wurde von den Porsche Lackspezialisten in das Farbe nach Wahl Programm aufgenommen.<br><br>Erster Abnehmer außerhalb der Familie Essmann ist übrigens die Porsche Exclusive Manufaktur, die einen 911 GT3 RS (992) zu Ausstellungszwecken in diesem Farbton lackieren ließ.","https://player.vimeo.com/video/1097499074?h=de1d0db329","#0e792d",[3888],"NX","eberlegrün","/assets/pts/studio_NX.jpg?h=bd1bcd399721403f7c78c195a8a057a6",[3669,2852],"Persönlich und individuell: eberlegrün ist ein satter grüner Farbton, der ursprünglich auf Kundenwunsch im Rahmen des Farbe nach Wahl Plus Prozesses von Porsche entwickelt wurde und seit dem Jahr 2024 zum Portfolio des Farbe nach Wahl Programms gehört. Damit kann eberlegrün auch von anderen Kunden bestellt werden.<br><br>Der Name eberlegrün geht dabei auf den Nachnamen des Kunden zurück, der sich mit der Entwicklung seiner ganz persönlichen Lackfarbe einen Traum erfüllen konnte.<br><br>Eberlegrün kann als Mittelgrün beschrieben werden. Der markante Farbton weist eine Ähnlichkeit zur Lackfarbe essmanngrün auf, ist jedoch blauer und gedämpfter in seiner Ausprägung.","https://player.vimeo.com/video/1097455508?h=e39442138f","#0d6e3e",[3896],"UN","pythongrün","/assets/pts/studio_UN.jpg?h=40ff427a82f647c13bdcd6ee94b41b11",[2842,3669],"<p>Sportliche DNA: pythongrün ist ein kräftiger, frischer Grünton, der 2021 erstmals bei Porsche eingeführt und gezielt für Modelle mit Performance-Fokus entwickelt wurde.</p><p><br></p><p>Der glänzende, nicht-metallische Lack besticht durch seine intensive, tief gesättigte, leuchtend grüne Nuance, ohne dabei grell zu wirken. Kraftvoll und markant erinnert pythongrün in seiner Wirkung an Farbtöne wie vipergrün, hat jedoch einen größeren Grün-Anteil als Basis.</p><p><br></p><p>Pythongrün steht für Individualität und Mut zur Farbe – perfekt für Enthusiasten, die ein selbstbewusstes Statement setzen möchten.</p>","https://player.vimeo.com/video/1163939754?h=242a68a044","#0c7e3c",[3904],"KE","vipergrün","/assets/pts/studio_KE.jpg?h=faa9a012f49da201de54bef7d7c66a71",[3669,2852],"<p>Trendsetter: wohl kaum eine Farbe ist neben Weiß so eng mit dem 911 Carrera RS 2.7 verbunden wie vipergrün. Die extrovertierte Farbe ist ein heller wie kräftiger Grünton, der an die Färbung einer Vipernschlange erinnert. Das neonartige vipergrün ermöglicht durch den satten Look einen starken Auftritt und betont bei RS-Modellen die gehobene Performanceausstattung.</p><p><br></p><p>Vipergrün ist von 1972 bis 1973 und erneut in den 2010er Jahren bestellbar. Als Farbe nach Wahl ist vipergrün für die Porsche Modelle 911, 718 und Taycan sowie Panamera und Macan verfügbar.</p><p><br></p><p>Vipergrün ist ein spezifischer Farbton, der mit seinem knalligen Erscheinungsbild eine unverkennbare Strahlkraft erzeugt und mit einem leichten gelben Unterton ausgestattet ist. Die einprägsame grüne Fahrzeugfarbe wird gern für Akzentteile verwendet, um Kontraste zu erzeugen und dadurch Aufmerksamkeit auf Komponenten wie den Heckflügel oder auch die Lufteinlässe zu lenken.</p>","https://player.vimeo.com/video/1097523231?h=c4479de27c","#0e9132",[3912],"DQ","reingrün","/assets/pts/studio_DQ.jpg?h=d55a58ab05a8c96f6fa2874ce82b9cc0",[3669,2852],"Die Frische der Natur: reingrün ist ein heller, lebendiger Grünton, welcher der Farbe von frischem Gras oder den Blättern einer grünen Pflanze nachempfunden ist. Der Farbton ist eine Primärfarbe, die nicht durch Mischen anderer Farben erzeugt werden kann und daher oft als Grundfarbe verwendet wird. Die belebende Atmosphäre von reingrün wird mit Natur, Wachstum und Vitalität in Verbindung gebracht.<br><br>Reingrün ist ein klares, helles Grün ohne blaue oder gelbe Untertöne. Es wird als Farbton verwendet, um Natürlichkeit zu betonen und eine erfrischende Umgebung zu schaffen.","https://player.vimeo.com/video/1099304504?h=273cd8cba3","#0d8b31",[3920],"HO","signalgrün","/assets/pts/studio_HO.jpg?h=52c7c48c5cc737e4f7eff8b0629264ef",[3669,2852],"Auffallend anders: signalgrün ist ein knalliger und historischer Porsche Farbton, der vipergrün ähnelt und vor allem auf den Porsche Transaxle-Modellen bekannt ist. Die Farb-Herkunft reicht bis Ende der 1960er Jahre zurück und hat fünf unterschiedliche Farbcodes durchlaufen.<br><br>Signalgrün ist ein gut erkennbarer Grünton, der als Farbsignal eine wichtige Funktion hat und für den Start oder eine Erlaubnis steht. Der Farbton wirkt beruhigend sowie erfrischend und wird oft mit der Natur, Gleichgewicht und Harmonie assoziiert.","https://player.vimeo.com/video/1097498355?h=f6cf783cb6","#0ea14b",[3928],"H7","grün","/assets/pts/studio_H7.jpg?h=374c0177e742f2c9aa567baac34543d8",[3669,2852],"Das Startsignal: die Farbe grün hat bei Porsche eine lange Tradition. Bis heute gibt es beim Sportwagenhersteller dutzende verschiedene Grüntöne, die von zurückhaltend und gedeckt bis extrovertiert reichen. Porsche schafft es mit seinen Farben, einen entscheidenden Kontrast zur präzise entwickelten Fahrzeugtechnik herzustellen. Dazu tragen auch die Farbnamen bei, die gerade im grünen Bereich stets spezielle bis hin zu mystischen Namen besitzen.<br><br>Die Farbe grün, auch bekannt als „RS green“, ist im Jahr 2007 für den 911 GT3 RS (997.1) entwickelt und als Kommunikationsfarbe gewählt worden.<br><br>Grün ist ein extrovertierter und strahlender Farbton, der positive Emotionen weckt und den sportlichen Charakter eines Sportwagens ausdrucksstark unterstützt.","https://player.vimeo.com/video/1097433998?h=748f36eb64","#0ea245",[3936],"UK","lizardgrün","/assets/pts/studio_UK.jpg?h=af297f8aac8b393e590d2f555caa527b",[3669,2852],"<p>Bewusst auffällig: lizardgrün ist eine extrovertierte Farbe, die Sportlichkeit, Agilität und Wendigkeit vermittelt. Eigenschaften, die insbesondere bei Hochleistungssportwagen im Fokus stehen. Genau aus diesem Grund wurde die Farbe im Jahr 2018 erstmalig als Präsentations- und Kommunikationsfarbe für den 911 GT3 RS (991.2) gewählt.</p><p><br></p><p>Lizardgrün ist ein heller, kräftiger Grünton, der in die Richtung Zitronengelb tendiert. Der Name leitet sich vom englischen Wort „lizard“ für „Eidechse“ ab – eine Metapher für die lebhafte Grünnuance, die an die Färbung bestimmter Reptilien erinnert.</p><p><br></p><p>Das polarisierende Grün ist nicht nur ein Blickfang, sondern unterstreicht auch das charakterstarke Statement eines Fahrzeugs. Es ist die ideale Farbe für Fahrzeuge, die Dynamik, Selbstbewusstsein und Persönlichkeit ausstrahlen sollen.</p>","https://player.vimeo.com/video/1163939810?h=ab5c5a6dbf","#5fac34",[3944],"F9","gelbgrün","/assets/pts/studio_F9.jpg?h=ef2bfaeab0e7392d733cffe417a0dec7",[3669,2852],"Ikonische Vitalität: gelbgrün oder grüngelb? Der frische Grünfarbton gelbgrün steht für Lebensfreude und kann durch seine Farbpräsenz im ersten Moment auch als bissig wahrgenommen werden. Die Farbe wurde auch als „grüngelb“ bezeichnet und ist fest mit der Porsche Historie und mit dem 911 RSR verbunden, der 1974 beim International Race of Champions (IROC) für Furore gesorgt hat.<br><br>Gelbgrün ist eine Mischung aus Grün und Gelb, die oft mit Natur, Frische sowie dem Frühling assoziiert wird. Die Lackierung kann je nach Lichteinfall und Betrachter als grüner oder gelber wahrgenommen werden.<br><br>Die besten zwölf Fahrer der Welt aus Formel 1, NASCAR, Indy 500, Can-Am, Stock Car und Le Mans sollten beim IROC in der ersten Saison auf buntlackierten Porsche 911 RS 3.0-Modellen gegeneinander antreten – was sich nicht nur beim gerade aufkommenden Farbfernsehen als Hingucker erweisen sollte. Der Carrera RSR #10 Petty in gelbgrün ist einer von nur 15 verschieden lackierten Exemplaren, die Porsche für das IROC 1973 gebaut hat.","https://player.vimeo.com/video/1097521031?h=980a1d66b1","#63b831",[3952],"K6","lindgrün","/assets/pts/studio_K6.jpg?h=2c0067f24fa36ad064cb7dfb70e06717",[3669,2852],"Verspieltes Statement: lindgrün – auch bekannt unter dem Namen „chartreuse“ - ist ein heller gelblich-grüner Farbton, der mit dem Ur-Elfer der Jahre 1967-1973 verbunden ist. Als Sonderfarbe ist die historische Porsche Farbe lindgrün Anfang der 1970er Jahre für den noch jungen 911 Targa (Farbcode 6710) und das Coupé (Farbcode 6767) verfügbar gewesen.<br><br>Lindgrün kann je nach Kontext leicht variieren, umfasst in seinem Farbspektrum helle bis mittlere Grüntöne und verfügt über einen gelben Unterton. Der lebendige und intensive Farbton ist auffällig und kann ein Gefühl der Frische sowie von Lebendigkeit hervorrufen. Weitere Assoziationen entstehen durch den Blick in die Natur: lindgrün erinnert in seiner Farbqualität an das Laub während der Frühlings- und Sommermonate, wodurch eine Verbindung zu Wachstum und Erneuerung hergestellt wird.<br><br>Insgesamt ist lindgrün eine dynamische und aufmerksamkeitsstarke Farbe, die eine Form von Verspieltheit und Jugendlichkeit ausstrahlt.","https://player.vimeo.com/video/1097523672?h=64cef849e7","#8d8f22",[3960],"CX","peridotmetallic","/assets/pts/studio_CX.jpg?h=aa426cd1b9a4ea7a951f4265a96fbe90",[2842,3669],"Rebellischer Charakter: der interessant klingende Farbton peridotmetallic hat eine goldgrüne Färbung und ist vom Halbedelstein Peridot inspiriert, der einen ähnlichen Farbton mit einem gelblich bis hellgrünen Glanz aufweist.<br><br>Auf der LA Auto Show am 17. November 2010 ist der Cayman R in der Kommunikationsfarbe peridotmetallic vorgestellt worden. Der Serienfarbton ist anschließend bis 2016 auch für alle anderen Modellreihen verfügbar.<br><br>Peridotmetallic ist ein hellgrüner Farbton mit einem goldenen oder bronzenen Unterton. Das metallische Finish verleiht der Farbe Tiefe und Glanz. Als Akzentfarbe versprüht peridotmetallic Lebendigkeit und Energie.","https://player.vimeo.com/video/1097436434?h=72258aa890","#b1b352",[3968],"K4","lichtgrün","/assets/pts/studio_K4.jpg?h=851ab88377209bd03bafad31de64dc8a",[3669,2852],"<p>Erfrischend und jugendlich: lichtgrün ist ein heller und kräftiger Grünton, der vermutlich von der hellgrünen bis gelblichen Farbe der Birkenblätter nachempfunden ist. Birke heißt im englischen „birch“ und der Farbton lichtgrün ist auch als „birchgreen“ gelistet – denn die Birke ist wiederum Sinnbild für das Frühlingserwachen, den Neubeginn und symbolisiert das Licht. Lichtgrün weist eine hohe Sättigung auf, die ihm eine auffällige Wirkung ermöglicht.</p><p><br></p><p>Der energiegeladene Farbton ist Mitte der 1970er Jahre auf den 911 Modellen (G-Modell) unter dem heutigen Farbcode zur Auswahl gestanden.</p><p><br></p><p>Lichtgrün ist als frischer und luftiger Farbton in der Lage, eine beruhigende Atmosphäre zu erzeugen.</p>","https://player.vimeo.com/video/1096926759?h=5c6a40df6a","#a9c30e",[3976],"A4","acidgrün","/assets/pts/studio_A4.jpg?h=0310415fa357d43ccf524f62d25b7ecb",[3669,2852],"Extrovertiert: acidgrün gehört zu den jüngsten Vertretern der Porsche Sonder-Farbpalette und ist vom Bremssattel-Ton der Hybrid-Modelle der 2000er Jahre abgeleitet. Porsche hat die moderne Akzentfarbe für die E-Hybrid-PHEV-Fahrzeuge entwickelt und läutet damit auch optisch das Zeitalter der Elektromobilität im Sportwagenbau ein.<br><br>Das kräftige Neongrün ist erstmalig als Exterieur Gesamtlackierung auf dem Supersportwagen 918 Spyder zu sehen.<br><br>Acidgrün kann als ein kräftiges Neongrün mit Untertönen von hellerem Gelb beschrieben werden. Die Farbe ist stärker gesättigt als hellgrün und ist im Vergleich zu gelbgrün gelblicher in ihrer Ausprägung. Der Anspruch von acidgrün scheint klar: auf besonders extrovertierte Art wird mit dem knalligen Farbton der hochperformante Charakter des Fahrzeugs betont.","https://player.vimeo.com/video/1097436142?h=49756b18d9","#cbf10f",[3984],"I6","hellgrün","/assets/pts/studio_I6.jpg?h=e9565c90f19afd07cbf35966e62f737a",[3669,2852],"Prägnant, durchdringend und extrovertiert: hellgrün ist eine historische Porsche Farbe, die früher jadegrün hieß und im Laufe der Jahre eine Namensanpassung erfahren hat. Hellgrün war auf dem 911 (F-Modell) in den 1970er Jahren verfügbar. Wie zahlreiche Farben aus dieser Zeit, ist auch hellgrün ein knalliger einprägsamer Farbton, der ein gewagtes Statement setzt.<br><br>Hellgrün ist eine lebendige, fast türkisfarbene Farbe mit einem leicht blauen Unterton. Der Farbton ist heller und blauer als das bekannte vipergrün und nimmt im Vergleich zu mintgrün einen wärmeren, farblich intensiveren Ton an. In der Saison 1974 ist beim International Race of Champions (IROC) ein 911 Carrera RSR in hellgrün unterwegs gewesen.","https://player.vimeo.com/video/1097524270?h=95a35db2b1","#0dac78",[3992],"M2","mintgrün","/assets/pts/studio_M2.jpg?h=e9d028d9941f1a8242331cfa0de38789",[3669,2852],"Erfrischend: mintgrün ist ein heller und kühler Grünton, der sich von der englischen Bezeichnung der Minzpflanze ableitet. Die Farbe wird durch ihren erfrischenden Look mit der Natur und dem Frühling in Verbindung gebracht, da sie den sanften Grüntönen frischer Blätter und frisch gewachsenen Grases ähnelt.<br><br>Ab Anfang der 1990er Jahre ist die Farbe für den 928, 968, 911 und 964 verfügbar gewesen. Das in den 1970er Jahren aufkommende jadegrün hat Ähnlichkeit mit mintgrün, jedoch ist mintgrün ein deutlich helleres Grün.<br><br>Mintgrün ist ein blassgrüner Farbton mit einem leichten Blaustich, der ihm ein pastellartiges Aussehen verleiht. Insgesamt ist mintgrün eine sanfte und zarte Farbe, die Gefühle der Ruhe, Gelassenheit und Entspannung vermittelt.","https://player.vimeo.com/video/1097497907?h=e2e7ad87ed","#60cba7",[4000],"TD","viridiansnowmetallic","/assets/pts/studio_TD.jpg?h=280bca6643e9b5c0e19cccb60caf0372",[2842,3669],"<p>Lebendige Frische: viridiansnowmetallic ist ein helles, kühles Grünmetallic mit minziger Aquanote, das sich visuell zwischen eistürkis und hellgrün bewegt.</p><p><br></p><p>Der außergewöhnliche Farbton wurde auf individuellen Kundenwunsch über das Farbe nach Wahl Plus Programm umgesetzt und ist jetzt als Farbe nach Wahl für alle Porsche Enthusiasten verfügbar.</p><p><br></p><p>Viridiansnowmetallic vereint die kühle Reinheit von Schnee mit der tiefen Eleganz eines edlen Hellgrüns. Feine Metallic Pigmente verleihen der Oberfläche faszinierende Lichtreflexe und eine beeindruckende Tiefenwirkung: In direktem Licht öffnet sich der Ton zu einem schneehellen, fast perlmuttigen Glanz, im Schatten zeigt er eine dezente Aquamarin Sättigung. Dadurch entsteht eine moderne, leichte und technische Anmutung, die die Fahrzeugsilhoutte klar zeichnet und mit einem frostigen Schimmer betont.</p>","https://player.vimeo.com/video/1163940044?h=277084caf7","#8dc2a7",{"_1500":636,"_4370":4994,"_1602":1420,"_566":6387,"_2840":-7,"_2841":-7,"_4372":-7,"_4373":55,"_4302":55,"_1509":-7,"_4374":-7,"_4375":-7,"_4376":6388,"_2826":-7,"_4378":-7,"_2837":55,"_277":2036,"_4379":631,"_2839":-7,"_4380":-7,"_1502":1490,"_4381":-7,"_4382":-7,"_4581":6
34,4035,4036,4037,4038],[],"category-ABC_group-groupABC0",[7341],[6988,6989],[],"category-ABA",{"_6904":7342,"_1500":6245,"_4389":-7,"_1502":-7,"_566":-7,"_6899":7343,"_4390":7344},[4030,4031,4032],[],"category-ABA_group-groupABA0",[7349],[6988,6989],[1620,1646],"category-IRZ",{"_6904":7350,"_1500":6253,"_4389":-7,"_1502":-7,"_566":-7,"_6899":7351,"_4390":7352},[4027,4028,4029],[1620,1646],"category-IRZ_group-groupIRZ0",[7357],[6988,6989],[1661],"category-IRL",{"_6904":7358,"_1500":6266,"_4389":-7,"_1502":-7,"_566":-7,"_6899":7359,"_4390":7360},[4024,4025,4026],[1661],"category-IRL_group-groupIRL0",[7363],[724],{"_6904":7364,"_1500":6277,"_4389":-7,"_1502":6278,"_566":-7,"_6899":7365,"_4390":6993},[4020,4021,4022,4023],[724],[7368],[7000],{"_6894":7369,"_6891":6997,"_6897":71,"_6890":55,"_4384":1121,"_6898":631,"_1500":1124,"_1502":1126,"_6899":7370,"_4390":6999},[7371,7372,7373,7374,7375],[688],{"_6904":7545,"_1500":6380,"_4389":-7,"_1502":6381,"_566":7003,"_6899":7546,"_4390":7005},{"_6904":7541,"_1500":6360,"_4389":-7,"_1502":6361,"_566":7542,"_6899":7543,"_4390":7544},{"_6904":7537,"_1500":6329,"_4389":-7,"_1502":6330,"_566":7538,"_6899":7539,"_4390":7540},{"_6904":7533,"_1500":6302,"_4389":-7,"_1502":6303,"_566":7534,"_6899":7535,"_4390":7536},{"_6904":7376,"_1500":6295,"_4389":-7,"_1502":279,"_566":-7,"_6899":7377,"_4390":7378},[7379,4019],[],"category-IAF_group-group-PTS",{"_1500":1114,"_4370":1501,"_1602":1124,"_566":7380,"_2840":71,"_2841":-7,"_4372":6291,"_4373":55,"_4302":55,"_1509":7381,"_4374":-7,"_4375":71,"_4376":7382,"_2826":-7,"_4378":-7,"_2837":55,"_277":2838,"_4379":280,"_2839":-7,"_4380":-7,"_7383":-7,"_1502":279,"_4381":-7,"_4382":71,"_4581":7384,"_4383":-7,"_4384":1121,"_4385":1121,"_2300":1126,"_4386":6295,"_4388":279,"_4389":-7,"_4390":7385},"<p>Sie fragen sich, ob man etwas Besonderes noch außergewöhnlicher und individueller gestalten kann? Man kann: Mit dem Farbe nach Wahl Programm.</p><p>Egal ob elegant oder extravagant, ob historisch oder modern, knallig oder zurückhaltend – das Farbe nach Wahl Programm bietet ein umfangreiches Sortiment an über 230 eindrucksvollen Exterieurfarben über alle Modelle – für die individuelle Gestaltung Ihres ganz persönlichen Porsche.</p><p>Hinweis: Jede Farbe aus dem Farbe nach Wahl Programm wird nach Eingang Ihrer Bestellung individuell für Ihr Fahrzeug in der spezifischen Lackmenge hergestellt. Die Festlegung Ihrer Wunschfarbe muss deshalb mindestens 3 Monate vor dem von Ihrem Porsche Partner genannten Produktionsmonat erfolgen.</p><p>Wir empfehlen: Wenden Sie sich bei Interesse am Farbe nach Wahl Programm an Ihr zuständiges Porsche Zentrum. Dieses steht bei allen Fragen rund um das Thema Farbe zur Verfügung und kann mit realen Lackmustern die bestmögliche Beratung bieten.</p><p>Farbe nach Wahl in digitalen Medien und Printmedien: Die Darstellung der Farbe kann je nach Kalibrierung der Ausgabegeräte (Monitor, Drucker, etc.) vom tatsächlichen Farbton abweichen.</p><p>Farbe nach Wahl am Fahrzeug:</p><p>- Der gleiche Farbton kann auf Fahrzeugen mit verschiedenen Karosserieformen eine unterschiedliche optische Wirkung entfalten.</p><p>- Im Rahmen des Farbe nach Wahl Programms setzen wir uns dafür ein, historische Porsche Farben wieder bestellbar zu machen. Da die Lacke früher mit anderen Inhaltsstoffen hergestellt wurden und im Laufe der Zeit einem Alterungsprozess unterliegen, lässt sich mit moderner Technik möglicherweise nur eine bestmögliche Annäherung an den ursprünglichen Farbton erzielen.</p><p>- Die Verwendung identischer Farbnamen durch andere Hersteller außerhalb von Porsche lässt nicht ohne Weiteres auf eine optische Übereinstimmung der entsprechenden Farbtöne schließen.</p><p>- Für jedes Fahrzeug wird eine eigene Lackcharge produziert. Aus diesem Grund kann es zu farblichen Abweichungen zwischen verschiedenen Fahrzeugen des gleichen Farbe nach Wahl Farbtons kommen.</p><p>Weitere Informationen zum Farbe nach Wahl Programm und zu Lieferzeiten erhalten Sie bei Ihrem Porsche Partner.</p>","standard","/assets/exteriors/studio_0UB.jpg?h=3a02216f5a5cfdc6017103ec42867ae4","selectedColor",[7386,7387,7388,7389,7390,7391,7392,7393,7394,7395,7396,7397,7398,7399,7400,7401,7402,7403,7404,7405,7406,7407,7408,7409,7410,7411,7412,7413,7414,7415,7416,7417,7418,7419,7420,7421,7422,7423,7424,7425,7426,7427,7428,7429,7430,7431,7432,7433,7434,7435,7436,7437,7438,7439,7440,7441,7442,7443,7444,7445,7446,7447,7448,7449,7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532],"category-IAF_group-group-PTS_item-0UB.89.24931",{"_2826":3993,"_2828":3994,"_572":2829,"_1502":3995,"_2831":3996,"_2833":3997,"_566":3998,"_2836":3999,"_2837":55,"_1500":2060},{"_2826":3985,"_2828":3986,"_572":2829,"_1502":3987,"_2831":3988,"_2833":3989,"_566":3990,"_2836":3991,"_2837":55,"_1500":2061},{"_2826":3977,"_2828":3978,"_572":2829,"_1502":3979,"_2831":3980,"_2833":3981,"_566":3982,"_2836":3983,"_2837":55,"_1500":2062},{"_2826":3969,"_2828":3970,"_572":2829,"_1502":3971,"_2831":3972,"_2833":3973,"_566":3974,"_2836":3975,"_2837":55,"_1500":2063},{"_2826":3961,"_2828":3962,"_572":2829,"_1502":3963,"_2831":3964,"_2833":3965,"_566":3966,"_2836":3967,"_2837":55,"_1500":2064},{"_2826":3953,"_2828":3954,"_572":2829,"_1502":3955,"_2831":3956,"_2833":3957,"_566":3958,"_2836":3959,"_2837":55,"_1500":2065},{"_2826":3945,"_2828":3946,"_572":2829,"_1502":3947,"_2831":3948,"_2833":3949,"_566":3950,"_2836":3951,"_2837":55,"_1500":2066},{"_2826":3937,"_2828":3938,"_572":2829,"_1502":3939,"_2831":3940,"_2833":3941,"_566":3942,"_2836":3943,"_2837":55,"_1500":2067},{"_2826":3929,"_2828":3930,"_572":2829,"_1502":3931,"_2831":3932,"
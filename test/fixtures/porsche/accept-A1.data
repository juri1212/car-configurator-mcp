ividualität ausdrücken und ein Statement setzen.</p>",[],"category-IAF_group-26026",[4004,4005,4006,4007],"<p>In diese Kategorie fallen verschiedene Schattierungen von Weiß, Grau und Schwarz. Zudem finden sich hier Silbertöne. Dezente Nuancen erlauben eine moderne Personalisierung.</p>",[],"category-IAF_group-26025",[4002,4003],[688],"currency","EUR","locale","de-DE","settings",{"_7553":71,"_7554":55,"_7555":71,"_7556":71,"_7557":71,"_7558":55,"_42":71,"_7559":55},"eel","driveAway","priceDisclaimer","productSafety","porscheIdLogin","saveConfiguration","priceDisclaimerPeriodic","noticeHref","https://europa.eu/youreurope/garantien","noticeSrc","/public/legal-guarantee-notice-de-Cqq1edoA.svg","garanLabelHref","garanLabelSrc","reservationUrl","https://prs.porsche.com/matchmaker/reservation?clientId=icc","dealershipSignalingUrl","dealership-signaling.prsprod.porsche.digital","baseUrl",{"_7592":7593,"_7594":7593},"environments",[7575,7585,7586],"defaultEnvironment",{"_1500":7580,"_7581":7582,"_7583":7584},"isStreamingAvailable","isIODEnabled","optionIds",[1683,1678,1677,1650,1647,1106,1640,900,724,1638,1632,1631,1622,792,1615,746,688],"Oasis","night","/public/Oasis_night-bsHz0hAQ.webp","day","/public/Oasis_day-Csre0OKN.webp",{"_1500":7589,"_7581":7590,"_7583":7591},{"_1500":7587,"_7583":7588,"_7581":7588},"Whiteroom Porsche","/public/Studio-gw3JNn9K.webp","UrbanMacan","/public/Urban_night-jiIbrcf4.webp","/public/Urban_day-DL7wpSAH.webp","iodApi","https://prs.porsche.com","serviceApi","frontSouthWest",{"_574":7608,"_7600":7000,"_7601":7609,"_7603":7604,"_7605":7606,"_572":7607},"frontSouth",{"_574":7599,"_7600":6942,"_7601":7602,"_7603":7604,"_7605":7606,"_572":7607},"https://prs.porsche.com/iod/image/DE/992142/1/N4Igxg9gdgZglgcxALlAQynAtmgLnaAZxQG0BdAGnDSwFMAnNFUOAExRFoA9cBaAGwgB3XjHrRcIKhAAO+IsxAA3NPTgZJyEK1qEA1rlkgAvsaq0oSuOKh0omluy0B1ABZxcDCBCwBBfjKuTNJyBFDEqKZU-Iiu+FBIqCBsHAAivgCaUiCy8uHMUSAy4qwArmAOyU4gAJw1AEwAjAAs9dm5YRGgkLCIpCCNACoAzNnDAEKjVMMAUjXZAKwAHFlUAGwAklMgA
{
  "name": "vw-cc-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Volkswagen, Volkswagen Nutzfahrzeuge and Porsche configurators (volkswagen.de, volkswagen-nutzfahrzeuge.de, configurator.porsche.com)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:live": "VW_LIVE=1 vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "bin": {
    "vw-cc-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
